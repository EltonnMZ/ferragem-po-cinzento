function setSyncBar(s,m){const b=document.getElementById('sync-bar');b.className='loading';b.classList.add(s);document.getElementById('sync-text').textContent=m;}


function parseDecimalInput(v){
  if(v===null||v===undefined)return 0;
  const n=parseFloat(String(v).replace(',', '.').trim());
  return Number.isFinite(n)?n:0;
}
function formatQty(v){
  const n=Number(v||0);
  if(!Number.isFinite(n))return '0';
  return Number.isInteger(n)?String(n):n.toLocaleString('pt-MZ',{minimumFractionDigits:0,maximumFractionDigits:3});
}


async function initDB(force=false){
  if(dbInitPromise && !force)return dbInitPromise;
  dbInitPromise=(async()=>{
    setSyncBar('loading','A ligar à base de dados...');
    try{
      const{data,error}=await db.from('produtos').select('*').order('id');
      if(error&&error.code==='42P01'){
        setSyncBar('err','Base de dados não configurada');
        showToast('❌ Base de dados não configurada','red');
        return false;
      }
      if(error)throw error;

      produtos=data||[];

      const hoje=new Date().toISOString().slice(0,10);
      const{data:vd,error:ve}=await db.from('vendas').select('*').gte('criado_em',hoje).order('criado_em');
      if(ve)console.error('Erro ao carregar vendas:',ve);
      else vendas=vd||[];

      dbOk=true;
      setSyncBar('ok','🟢 Online · Tempo real');

      try{await loadMateriais();}catch(e){console.error('Erro ao carregar materiais:',e);}
      try{await loadAlugueis();}catch(e){console.error('Erro ao carregar alugueis:',e);}

      setTimeout(checkAlugueisAtraso,2000);

      if(!rtSubscribed){
        db.channel('stock')
          .on('postgres_changes',{event:'*',schema:'public',table:'produtos'},async()=>{await loadProdutos();})
          .subscribe();

        db.channel('sales')
          .on('postgres_changes',{event:'*',schema:'public',table:'vendas'},async()=>{await loadVendas();})
          .subscribe();

        db.channel('alugueis_rt')
          .on('postgres_changes',{event:'*',schema:'public',table:'alugueis'},async()=>{
            try{
              await loadAlugueis();
              renderAluguel();
              if(currentUser?.role==='gerencia')renderGerencia();
            }catch(e){console.error('Erro realtime alugueis:',e);}
          })
          .subscribe();

        db.channel('materiais_rt')
          .on('postgres_changes',{event:'*',schema:'public',table:'materiais'},async()=>{
            try{
              await loadMateriais();
              renderGerMateriais();
              renderMateriaisSelect();
            }catch(e){console.error('Erro realtime materiais:',e);}
          })
          .subscribe();

        rtSubscribed=true;
      }

      if(reconnectTimer){clearTimeout(reconnectTimer);reconnectTimer=null;}
      return true;
    }catch(e){
      console.error('Erro initDB:',e);
      dbOk=false;
      setSyncBar('err','🔴 Erro na ligação à base de dados');
      showToast('❌ Erro na ligação à base de dados.','red');
      if(reconnectTimer)clearTimeout(reconnectTimer);
      reconnectTimer=setTimeout(()=>initDB(true),10000);
      return false;
    }finally{
      dbInitPromise=null;
    }
  })();
  return dbInitPromise;
}

async function loadProdutos(){
  const{data,error}=await db.from('produtos').select('*').order('id');
  if(error){console.error('Erro ao carregar produtos:',error);return;}
  produtos=data||[];
  renderAll();
}

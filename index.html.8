function renderVenderSelect(){
  const sel=document.getElementById('v-prod');
  if(!sel)return;
  const selected=sel.value;
  const q=((document.getElementById('search-venda-prod')||{}).value||'').toLowerCase().trim();
  const disponiveis=produtos
    .filter(p=>p.qty>0 && (!q || p.nome.toLowerCase().includes(q)))
    .sort((a,b)=>a.nome.localeCompare(b.nome));
  sel.innerHTML='<option value="">-- Seleccionar produto --</option>';
  disponiveis.forEach(p=>{
    const extra=` — ${Number(getPrecoVendaProduto(p)||0).toLocaleString()} MZN`;
    sel.innerHTML+=`<option value="${p.id}">${escapeHTML(p.nome)} (${formatQty(p.qty)} un.)${extra}</option>`;
  });
  if(disponiveis.some(p=>String(p.id)===String(selected)))sel.value=selected;
  if(!disponiveis.length)sel.innerHTML='<option value="">Nenhum produto encontrado</option>';
  renderVendaResultados(disponiveis,q);
  renderCarrinhoVenda();
  updateProdutoVendaInfo();
}
function renderVendaResultados(disponiveis,q){
  const box=document.getElementById('v-prod-results');
  if(!box)return;
  const lista=(q?disponiveis:disponiveis.slice(0,6)).slice(0,10);
  if(!lista.length){
    box.innerHTML=q?'<div class="empty" style="padding:12px">Nenhum produto encontrado</div>':'<div class="empty" style="padding:12px">Sem produtos disponíveis para venda</div>';
    return;
  }
  box.innerHTML=lista.map(p=>{
    const preco=Number(getPrecoVendaProduto(p)||0);
    const jaNoCarrinho=carrinhoVenda.filter(i=>i.id===p.id).reduce((a,i)=>a+Number(i.qty||0),0);
    const restante=Math.max(0,Number(p.qty||0)-jaNoCarrinho);
    return `<button type="button" class="venda-prod-card" onclick="abrirQtyModal(${p.id})">
      <span>
        <span class="venda-prod-name">${escapeHTML(p.nome)}</span>
        <span class="venda-prod-meta">${formatQty(restante)} un. disponíveis${jaNoCarrinho?` · ${formatQty(jaNoCarrinho)} no carrinho`:''}</span>
      </span>
      <span>
        <span class="venda-prod-price">${preco.toLocaleString()} MZN</span>
        <span class="venda-prod-add">Qtd → adicionar</span>
      </span>
    </button>`;
  }).join('');
}
function selectProdutoVenda(id){
  const sel=document.getElementById('v-prod');
  if(sel)sel.value=String(id);
  updateProdutoVendaInfo();
  updatePreview();
}
function quickAddProdutoVenda(id){
  abrirQtyModal(id);
}
function abrirQtyModal(id){
  const p=produtos.find(x=>x.id===id);
  if(!p){showToast('Produto inválido','red');return;}
  produtoQtyModal=p;
  const overlay=document.getElementById('qty-modal-overlay');
  const input=document.getElementById('qty-modal-input');
  document.getElementById('qty-modal-name').textContent=p.nome;
  document.getElementById('qty-modal-stock').textContent='Stock: '+formatQty(p.qty)+' un.';
  document.getElementById('qty-modal-price').textContent=Number(getPrecoVendaProduto(p)||0).toLocaleString()+' MZN';
  if(input){
    input.value=document.getElementById('v-qty')?.value||'1';
    setTimeout(()=>{input.focus();input.select();},80);
  }
  updateQtyModalTotal();
  overlay?.classList.add('open');
}
function fecharQtyModal(){
  produtoQtyModal=null;
  document.getElementById('qty-modal-overlay')?.classList.remove('open');
}
function ajustarQtyModal(delta){
  const input=document.getElementById('qty-modal-input');
  if(!input)return;
  const atual=parseDecimalInput(input.value)||0;
  input.value=String(Math.max(1,atual+delta)).replace('.',',');
  updateQtyModalTotal();
}
function updateQtyModalTotal(){
  const p=produtoQtyModal;
  const totalEl=document.getElementById('qty-modal-total');
  if(!p||!totalEl)return;
  const qty=parseDecimalInput(document.getElementById('qty-modal-input')?.value||'1')||0;
  totalEl.textContent=(qty*Number(getPrecoVendaProduto(p)||0)).toLocaleString()+' MZN';
}
function confirmarQtyModal(){
  const p=produtoQtyModal;
  if(!p)return;
  const qty=parseDecimalInput(document.getElementById('qty-modal-input')?.value||'1')||0;
  if(!qty||qty<=0){showToast('Indica uma quantidade válida','red');return;}
  const jaNoCarrinho=carrinhoVenda.filter(i=>i.id===p.id).reduce((a,i)=>a+Number(i.qty||0),0);
  if(qty+jaNoCarrinho>Number(p.qty||0)){showToast('Stock insuficiente para este produto','red');return;}
  selectProdutoVenda(p.id);
  const qtyInput=document.getElementById('v-qty');
  if(qtyInput)qtyInput.value=String(qty).replace('.',',');
  adicionarProdutoVenda();
  fecharQtyModal();
  const search=document.getElementById('search-venda-prod');
  if(search){search.value='';search.focus();}
}
function updateProdutoVendaInfo(){
  const box=document.getElementById('v-prod-info');
  if(!box)return;
  const id=parseInt(document.getElementById('v-prod')?.value||'');
  const p=produtos.find(x=>x.id===id);
  if(!p){box.style.display='none'; return;}
  const qty=parseDecimalInput(document.getElementById('v-qty')?.value||'1')||1;
  const preco=getPrecoVendaProduto(p);
  const subtotal=preco*qty;
  box.style.display='block';
  document.getElementById('v-preco-unit').textContent=preco.toLocaleString()+' MZN';
  document.getElementById('v-prod-subtotal').textContent=subtotal.toLocaleString()+' MZN';
  document.getElementById('v-prod-stock').textContent=formatQty(p.qty)+' un. disponíveis';
}
function ajustarQtyProdutoVenda(delta){
  const input=document.getElementById('v-qty');
  if(!input)return;
  const atual=parseDecimalInput(input.value)||0;
  const prox=Math.max(1,atual+delta);
  input.value=String(prox).replace('.',',');
  updateProdutoVendaInfo();
  updatePreview();
}
function adicionarProdutoVenda(){
  const id=parseInt(document.getElementById('v-prod').value);
  const qty=parseDecimalInput(document.getElementById('v-qty').value)||1;
  if(!id){showToast('Selecciona um produto','red');return;}
  if(!qty||qty<=0){showToast('Indica uma quantidade válida','red');return;}
  const p=produtos.find(x=>x.id===id);
  if(!p){showToast('Produto inválido','red');return;}
  const jaNoCarrinho=carrinhoVenda.filter(i=>i.id===id).reduce((a,i)=>a+Number(i.qty||0),0);
  if(qty+jaNoCarrinho>Number(p.qty||0)){showToast('Stock insuficiente para este produto','red');return;}
  const preco=getPrecoVendaProduto(p);
  const compra=getCustoUnitarioVenda(p);
  const existente=carrinhoVenda.find(i=>i.id===id && Number(i.preco_unit)===preco);
  if(existente){existente.qty+=qty; existente.stock_qty=existente.qty; existente.subtotal=existente.qty*existente.preco_unit;}
  else{carrinhoVenda.push({id:p.id,nome:p.nome,qty,stock_qty:qty,tipo_venda:'base',unidade_label:'un.',base_label:'un.',preco_unit:preco,preco_compra_unit:compra,subtotal:qty*preco});}
  document.getElementById('v-qty').value='1';
  document.getElementById('v-prod').value='';
  updateProdutoVendaInfo();
  renderVenderSelect(); updatePreview(); showToast('Produto adicionado','green');
}
function removerProdutoVenda(index){carrinhoVenda.splice(index,1);renderCarrinhoVenda();renderVenderSelect();updatePreview();}
function alterarCarrinhoQty(index,delta){
  const item=carrinhoVenda[index];
  if(!item)return;
  const produto=produtos.find(p=>p.id===item.id);
  const nova=Number(item.qty||0)+delta;
  if(nova<=0){removerProdutoVenda(index);return;}
  if(produto && nova>Number(produto.qty||0)){showToast('Stock insuficiente para '+item.nome,'red');return;}
  item.qty=nova;
  item.stock_qty=nova;
  item.subtotal=nova*Number(item.preco_unit||0);
  renderCarrinhoVenda();
  renderVenderSelect();
  updatePreview();
}
function limparCarrinhoVenda(){
  if(!carrinhoVenda.length)return;
  carrinhoVenda=[];
  salvarCarrinhoAtivo();
  renderCarrinhoVenda();
  renderVenderSelect();
  updatePreview();
  showToast('Carrinho limpo','green');
}
function getCarrinhoAtivo(){
  let cart=carrinhosVenda.find(c=>c.id===carrinhoAtivoId);
  if(!cart){
    cart=carrinhosVenda[0]||{id:1,nome:'Carrinho 1',itens:[],cliente:'',pagamento:'cash',entregue:''};
    carrinhosVenda=[cart];
    carrinhoAtivoId=cart.id;
  }
  return cart;
}
function salvarCarrinhoAtivo(){
  const cart=getCarrinhoAtivo();
  cart.itens=carrinhoVenda.map(i=>({...i}));
  cart.cliente=document.getElementById('v-cliente')?.value||'';
  cart.pagamento=pagamento;
  cart.entregue=document.getElementById('v-entregue')?.value||'';
}
function carregarCarrinhoAtivo(){
  const cart=getCarrinhoAtivo();
  carrinhoVenda=(cart.itens||[]).map(i=>({...i}));
  const cliente=document.getElementById('v-cliente');
  const entregue=document.getElementById('v-entregue');
  if(cliente)cliente.value=cart.cliente||'';
  pagamento=cart.pagamento||'cash';
  selectPag(pagamento);
  if(entregue)entregue.value=cart.entregue||'';
  renderCarrinhoVenda();
  renderVenderSelect();
  updatePreview();
}
function renderCarrinhosVenda(){
  const tabs=document.getElementById('cart-tabs');
  if(!tabs)return;
  tabs.innerHTML=carrinhosVenda.map(cart=>{
    const unidades=(cart.id===carrinhoAtivoId?carrinhoVenda:cart.itens||[]).reduce((a,i)=>a+Number(i.qty||0),0);
    const close=carrinhosVenda.length>1?`<button class="cart-tab-close" type="button" aria-label="Fechar ${escapeHTML(cart.nome)}" onclick="removerCarrinhoVenda(${cart.id},event)">×</button>`:'';
    return `<div class="cart-tab ${cart.id===carrinhoAtivoId?'active':''}" role="button" tabindex="0" onclick="trocarCarrinhoVenda(${cart.id})" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();trocarCarrinhoVenda(${cart.id})}">
      ${escapeHTML(cart.nome)}
      <span class="cart-tab-count">${formatQty(unidades)}</span>
      ${close}
    </div>`;
  }).join('');
}
function trocarCarrinhoVenda(id){
  if(id===carrinhoAtivoId)return;
  salvarCarrinhoAtivo();
  carrinhoAtivoId=id;
  carregarCarrinhoAtivo();
}
function novoCarrinhoVenda(){
  salvarCarrinhoAtivo();
  const id=proximoCarrinhoId++;
  carrinhosVenda.push({id,nome:'Carrinho '+carrinhosVenda.length+1,itens:[],cliente:'',pagamento:'cash',entregue:''});
  carrinhoAtivoId=id;
  carregarCarrinhoAtivo();
  document.getElementById('search-venda-prod')?.focus();
}
function removerCarrinhoVenda(id,event){
  event?.stopPropagation();
  if(carrinhosVenda.length<=1){limparCarrinhoVenda();return;}
  const idx=carrinhosVenda.findIndex(c=>c.id===id);
  if(idx<0)return;
  carrinhosVenda.splice(idx,1);
  carrinhosVenda.forEach((c,i)=>c.nome='Carrinho '+(i+1));
  if(carrinhoAtivoId===id)carrinhoAtivoId=(carrinhosVenda[Math.max(0,idx-1)]||carrinhosVenda[0]).id;
  carregarCarrinhoAtivo();
}
function renderCarrinhoVenda(){
  const el=document.getElementById('carrinho-venda'); if(!el)return;
  salvarCarrinhoAtivo();
  renderCarrinhosVenda();
  if(!carrinhoVenda.length){el.innerHTML='<div class="empty">Nenhum produto adicionado</div>';updateVendaResumo();return;}
  el.innerHTML=carrinhoVenda.map((i,idx)=>`<div class="cart-row"><div class="cart-info"><div class="cart-name">${escapeHTML(i.nome)}</div><div class="cart-sub">${formatQty(i.qty)} un. x ${Number(i.preco_unit||0).toLocaleString()} MZN</div></div><div class="cart-tools"><div class="cart-total">${Number(i.subtotal||0).toLocaleString()} MZN</div><div class="qty-stepper"><button type="button" aria-label="Diminuir ${escapeHTML(i.nome)}" onclick="alterarCarrinhoQty(${idx},-1)">−</button><span>${formatQty(i.qty)}</span><button type="button" aria-label="Aumentar ${escapeHTML(i.nome)}" onclick="alterarCarrinhoQty(${idx},1)">+</button></div><button class="cart-remove" aria-label="Remover ${escapeHTML(i.nome)}" onclick="removerProdutoVenda(${idx})">X</button></div></div>`).join('');
  updateVendaResumo();
}
function updatePreview(){
  const pv=document.getElementById('v-preview'); if(!pv)return;
  const total=getTotal(); updateVendaResumo(); if(!total){pv.style.display='none';return;}
  pv.style.display='block'; document.getElementById('troco-total').textContent=total.toLocaleString()+' MZN';
  const ts=document.getElementById('troco-section'); if(ts)ts.style.display=pagamento==='cash'?'block':'none'; calcTroco();
}
function getTotal(){return carrinhoVenda.reduce((a,i)=>a+Number(i.subtotal||0),0);}
function updateVendaResumo(){
  const total=getTotal();
  const totalEl=document.getElementById('venda-total-fixo');
  const countEl=document.getElementById('venda-itens-count');
  const subEl=document.getElementById('venda-cart-subtitle');
  const unidades=carrinhoVenda.reduce((a,i)=>a+Number(i.qty||0),0);
  if(totalEl)totalEl.textContent=total.toLocaleString()+' MZN';
  if(countEl)countEl.textContent=unidades.toLocaleString();
  if(subEl)subEl.textContent=carrinhoVenda.length?`${carrinhoVenda.length} produto(s) · ${formatQty(unidades)} unidade(s)`:'Venda actual';
}

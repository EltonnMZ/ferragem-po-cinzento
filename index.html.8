function goScreen(name,btn){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('on'));
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
  const screen=document.getElementById('screen-'+name);
  if(screen)screen.classList.add('on');
  if(btn)btn.classList.add('active');
  try{
    if(name==='gerencia')renderGerencia();
    if(name==='vender'){renderVenderSelect();renderHistorico();}
    if(name==='aluguel'){renderAluguel();}
  }catch(e){
    console.error('Erro ao mudar de ecrã:',e);
  }
}

async function fecharDia(){
  const tot=vendas.reduce((a,v)=>a+v.total,0);
  const cash=vendas.filter(v=>!v.pagamento||v.pagamento==='cash').reduce((a,v)=>a+v.total,0);
  const mpesa=vendas.filter(v=>v.pagamento==='mpesa').reduce((a,v)=>a+v.total,0);
  const emola=vendas.filter(v=>v.pagamento==='emola').reduce((a,v)=>a+v.total,0);
  const custo=vendas.reduce((a,v)=>a+(v.preco_compra_unit||0)*v.qty,0);
  const lucro=tot-custo;
  const lines=[
    '=== RELATÓRIO DIÁRIO — FERRAGEM PO CINZENTO ===',
    `Data: ${new Date().toLocaleDateString('pt-MZ')}`,
    `Total de vendas: ${vendas.length}`,
    `Receita total: ${tot.toLocaleString()} MZN`,
    `  Numerário: ${cash.toLocaleString()} MZN`,
    `  M-Pesa: ${mpesa.toLocaleString()} MZN`,
    `  E-Mola: ${emola.toLocaleString()} MZN`,
    `Custo mercadorias: ${custo.toLocaleString()} MZN`,
    `LUCRO LÍQUIDO: ${lucro.toLocaleString()} MZN`,
    '','--- VENDAS ---',
    ...vendas.map(v=>`${v.criado_em?new Date(v.criado_em).toTimeString().slice(0,5):''} | ${v.produto_nome} | ${formatQty(v.qty)}un | ${v.total}MZN | ${v.funcionario} | ${v.pagamento||'cash'}`),
    '','--- STOCK FINAL ---',
    ...produtos.map(p=>`${p.nome}: ${formatQty(p.qty)} un.`)
  ];
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([lines.join('\n')],{type:'text/plain'}));
  a.download=`relatorio_${new Date().toISOString().slice(0,10)}.txt`;
  a.click();
}

function showToast(msg,type){
  const t=document.createElement('div');t.textContent=msg;
  const bg=type==='red'?'var(--red)':'var(--green)';
  const c=type==='red'?'#fff':'#0f1923';
  t.style.cssText=`position:absolute;bottom:90px;left:50%;transform:translateX(-50%);background:${bg};color:${c};padding:10px 20px;border-radius:20px;font-size:13px;font-weight:600;z-index:200;white-space:nowrap;font-family:var(--font-head)`;
  document.getElementById('app').appendChild(t);
  setTimeout(()=>t.remove(),2500);
}


  const hoje=new Date().toISOString().slice(0,10);
  const{data,error}=await db.from('vendas').select('*').gte('criado_em',hoje).order('criado_em');
  if(error){console.error('Erro ao carregar vendas:',error);return;}
  vendas=data||[];

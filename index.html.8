<!DOCTYPE html>
<html lang="pt">
<head>
<link rel="icon" href="logo.jpg" type="image/jpeg">
<link rel="icon" href="icon-192.png" type="image/png">
<link rel="apple-touch-icon" href="icon-192.png">
<link rel="manifest" href="manifest.webmanifest">
<meta name="mobile-web-app-capable" content="yes">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Sistema de gestão de vendas, stock e alugueres da Ferragem Pó Cinzento.">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#0f1923">
<title>Ferragem Pó Cinzento</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
:root{--bg:#0f1923;--surface:#162130;--surface2:#1e2d3e;--border:rgba(255,255,255,0.07);--accent:#f0a500;--green:#2dce7a;--red:#ff4d4d;--yellow:#f0a500;--text:#f0f4f8;--muted:#7a92a8;--font-head:'Syne',sans-serif;--font-body:'DM Sans',sans-serif}
*:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
.rel-tab{background:var(--surface);border:1px solid var(--border);color:var(--muted);padding:10px 4px;border-radius:12px;font-size:11px;font-weight:700;font-family:var(--font-head);cursor:pointer}
.rel-tab.active{background:var(--accent);color:#0f1923;border-color:var(--accent)}
.rel-stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
.rel-stat{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:14px}
.rel-stat-label{font-size:10px;color:var(--muted);margin-bottom:6px;font-weight:500;text-transform:uppercase;letter-spacing:.06em}
.rel-stat-val{font-size:22px;font-weight:800;font-family:var(--font-head);line-height:1}
.rel-section{font-family:var(--font-head);font-size:10px;font-weight:700;color:var(--muted);letter-spacing:.08em;text-transform:uppercase;margin:16px 0 10px}
.rel-row{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border)}
.rel-row:last-child{border-bottom:none}
.rel-time{font-size:10px;color:var(--muted);min-width:44px}
.rel-info{flex:1;min-width:0}
.rel-name{font-size:13px;font-weight:600;font-family:var(--font-head)}
.rel-sub{font-size:11px;color:var(--muted);margin-top:2px}
.rel-total{font-size:14px;font-weight:700;font-family:var(--font-head);color:var(--green);white-space:nowrap}
@media print{
  #rel-overlay{position:absolute!important;background:#fff!important;color:#000!important}
  #rel-print-bar,#rel-tabs,.rel-tab,#rel-de,#rel-ate,button{display:none!important}
  .rel-stat{background:#f5f5f5!important;border:1px solid #ddd!important}
  .rel-stat-val,.rel-name{color:#000!important}
  .rel-stat-label,.rel-sub,.rel-time,.rel-section{color:#555!important}
  .rel-total{color:#1a7a1a!important}
  #rel-content{color:#000}
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;min-height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:var(--font-body);overscroll-behavior:none}
#app{display:flex;flex-direction:column;height:100vh;height:100dvh;min-height:100vh;min-height:100dvh;max-width:480px;margin:0 auto;position:relative;overflow:hidden}
#login-screen{position:absolute;inset:0;background:var(--bg);z-index:999;display:flex;flex-direction:column;align-items:center;padding:40px 24px 32px;overflow-y:auto}
.login-logo{text-align:center;margin-bottom:36px}
.login-logo .icon{font-size:52px;margin-bottom:10px}
.login-logo h1{font-family:var(--font-head);font-size:28px;font-weight:800}
.login-logo h1 span{color:var(--accent)}
.login-logo .sub{font-size:12px;color:var(--muted);margin-top:4px}
.login-logo .owner{font-size:11px;color:var(--accent);margin-top:3px}
.login-section-label{font-family:var(--font-head);font-size:10px;font-weight:700;color:var(--muted);letter-spacing:.1em;text-transform:uppercase;margin-bottom:12px;text-align:center;width:100%}
.func-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;width:100%;margin-bottom:14px}
.func-card{background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:20px 12px;display:flex;flex-direction:column;align-items:center;gap:10px;cursor:pointer;transition:border-color .2s,transform .1s;width:100%}
.func-card:active{transform:scale(0.96)}
.func-card{animation:fadeInUp .3s ease both}
.func-card:nth-child(1){animation-delay:.05s}
.func-card:nth-child(2){animation-delay:.1s}
@keyframes fadeInUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
#login-screen{animation:none}
.func-card.gerencia{flex-direction:row;padding:16px 20px;gap:16px;justify-content:flex-start;border-color:rgba(240,165,0,0.3)}
.func-avatar{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:800;font-family:var(--font-head);flex-shrink:0}
.func-name{font-size:13px;font-weight:700;color:var(--text);text-align:center;font-family:var(--font-head);line-height:1.3}
.func-card.gerencia .func-name{text-align:left}
.func-role{font-size:10px;color:var(--muted);text-align:center;font-weight:500}
.func-card.gerencia .func-role{text-align:left;color:var(--accent)}
#pin-overlay{display:none;position:absolute;inset:0;background:rgba(0,0,0,0.85);z-index:1000;align-items:center;justify-content:center}
#pin-overlay.open{display:flex}
.pin-box{background:var(--surface);border-radius:24px;padding:28px 24px;width:88%;max-width:320px}
.pin-box h3{font-family:var(--font-head);font-size:18px;font-weight:700;text-align:center;margin-bottom:4px}
.pin-box p{font-size:12px;color:var(--muted);text-align:center;margin-bottom:20px}
.pin-dots{display:flex;justify-content:center;gap:12px;margin-bottom:24px}
.pin-dot{width:14px;height:14px;border-radius:50%;border:2px solid var(--muted);transition:all .15s}
.pin-dot.filled{background:var(--accent);border-color:var(--accent)}
.pin-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.pin-btn{padding:17px;background:var(--surface2);border:1px solid var(--border);border-radius:12px;color:var(--text);font-size:22px;font-family:var(--font-head);font-weight:600;cursor:pointer}
.pin-btn:active{background:var(--accent);color:#0f1923}
.pin-btn.small{font-size:12px;color:var(--muted)}
.pin-cancel{width:100%;margin-top:12px;padding:12px;background:transparent;border:1px solid var(--border);border-radius:10px;color:var(--muted);font-size:13px;cursor:pointer}
.auth-form{width:100%;display:flex;flex-direction:column;gap:12px}
.auth-field{display:flex;flex-direction:column;gap:6px}
.auth-field label{font-size:11px;color:var(--muted);font-weight:600}
.auth-field input{width:100%;padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:12px;color:var(--text);font:14px var(--font-body)}
.auth-field input:focus{border-color:var(--accent)}
.auth-error{display:none;padding:10px 12px;border-radius:10px;background:rgba(255,77,77,.1);border:1px solid rgba(255,77,77,.25);color:var(--red);font-size:12px}
#sync-bar{padding:6px 16px;font-size:11px;text-align:center;flex-shrink:0;display:flex;align-items:center;justify-content:center;gap:6px}
#sync-bar.ok{background:rgba(45,206,122,0.1);color:var(--green)}
#sync-bar.err{background:rgba(255,77,77,0.1);color:var(--red)}
#sync-bar.loading{background:rgba(240,165,0,0.1);color:var(--yellow)}
.sync-dot{width:6px;height:6px;border-radius:50%;background:currentColor;flex-shrink:0}
#header{padding:14px 20px 12px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);flex-shrink:0}
#header-left h2{font-family:var(--font-head);font-size:18px;font-weight:800}
#header-left h2 span{color:var(--accent)}
#header-left .huser{font-size:11px;color:var(--muted);margin-top:2px}
#header-left .huser strong{color:var(--accent)}
#btn-logout{display:flex;align-items:center;gap:6px;padding:7px 12px;background:rgba(255,77,77,0.1);border:1px solid rgba(255,77,77,0.25);border-radius:20px;color:var(--red);font-size:11px;font-weight:600;font-family:var(--font-head);cursor:pointer}
#btn-logout svg{width:14px;height:14px}
.header-actions{display:flex;align-items:center;gap:8px}
#btn-fullscreen{display:none;align-items:center;gap:7px;padding:8px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:20px;color:var(--text);font-size:11px;font-weight:700;font-family:var(--font-head);cursor:pointer}
#btn-fullscreen svg{width:15px;height:15px}
#content{flex:1 1 auto;min-height:0;overflow-y:auto;overflow-x:hidden;padding:16px 20px calc(120px + env(safe-area-inset-bottom));-webkit-overflow-scrolling:touch;touch-action:pan-y;overscroll-behavior:contain}
#content::-webkit-scrollbar{width:3px}
#content::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
#nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:480px;background:var(--surface);border-top:1px solid var(--border);display:flex;padding:8px 0 calc(20px + env(safe-area-inset-bottom));z-index:60}
.nav-btn{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;padding:6px 0;cursor:pointer;border:none;background:transparent;color:var(--muted);font-family:var(--font-body);font-size:10px;font-weight:500}
.nav-btn.active{color:var(--accent)}
.nav-btn svg{width:22px;height:22px}
.screen{display:none}.screen.on{display:block}
.sec-title{font-family:var(--font-head);font-size:11px;font-weight:700;color:var(--muted);letter-spacing:.08em;text-transform:uppercase;margin-bottom:12px;margin-top:4px}
.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
.stats-grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:16px}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:14px}
.stat-label{font-size:11px;color:var(--muted);margin-bottom:6px;font-weight:500}
.stat-val{font-size:24px;font-weight:700;font-family:var(--font-head);line-height:1}
.stat-val.green{color:var(--green)}.stat-val.red{color:var(--red)}.stat-val.yellow{color:var(--yellow)}
.stat-val.purple{color:#afa9ec}
.card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:16px;margin-bottom:12px}
.badge{display:inline-block;font-size:10px;font-weight:600;padding:2px 8px;border-radius:20px}
.badge-ok{background:rgba(45,206,122,0.15);color:var(--green)}
.badge-low{background:rgba(240,165,0,0.15);color:var(--yellow)}
.badge-out{background:rgba(255,77,77,0.15);color:var(--red)}
.badge-mpesa{background:rgba(45,206,122,0.15);color:var(--green);font-size:10px;padding:2px 8px;border-radius:20px;font-weight:600}
.badge-emola{background:rgba(240,165,0,0.15);color:var(--yellow);font-size:10px;padding:2px 8px;border-radius:20px;font-weight:600}
.badge-cash{background:rgba(175,169,236,0.15);color:#afa9ec;font-size:10px;padding:2px 8px;border-radius:20px;font-weight:600}
.alert{border-radius:12px;padding:12px 14px;margin-bottom:10px;display:flex;gap:10px;align-items:flex-start}
.alert-red{background:rgba(255,77,77,0.1);border:1px solid rgba(255,77,77,0.25)}
.alert-yellow{background:rgba(240,165,0,0.1);border:1px solid rgba(240,165,0,0.25)}
.alert-green{background:rgba(45,206,122,0.1);border:1px solid rgba(45,206,122,0.25)}
.alert-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;margin-top:4px}
.alert-dot-red{background:var(--red)}.alert-dot-yellow{background:var(--yellow)}.alert-dot-green{background:var(--green)}
.alert-title{font-size:13px;font-weight:600}
.alert-body{font-size:12px;color:var(--muted);margin-top:2px;line-height:1.4}
.prod-row{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--border)}
.prod-row:last-child{border-bottom:none}
.prod-icon{width:40px;height:40px;border-radius:10px;background:var(--surface2);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px}
.prod-info{flex:1;min-width:0}
.prod-name{font-size:14px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.prod-meta{font-size:11px;color:var(--muted);margin-top:2px}
.prod-stock{text-align:right;flex-shrink:0}
.prod-qty{font-size:18px;font-weight:700;font-family:var(--font-head)}
.prod-unit{font-size:10px;color:var(--muted)}
.venda-row{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border)}
.venda-row:last-child{border-bottom:none}
.venda-time{font-size:11px;color:var(--muted);font-family:var(--font-head);min-width:38px}
.venda-info{flex:1}.venda-name{font-size:13px;font-weight:500}.venda-func{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:4px;margin-top:2px}
.venda-total{font-size:14px;font-weight:700;font-family:var(--font-head);color:var(--green);text-align:right}

.cart-row{display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-bottom:1px solid var(--border)}
.cart-row:last-child{border-bottom:none}
.cart-info{flex:1;min-width:0}
.cart-name{font-size:13px;font-weight:700;font-family:var(--font-head);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cart-sub{font-size:11px;color:var(--muted);margin-top:3px}
.cart-total{font-size:13px;font-weight:800;font-family:var(--font-head);color:var(--green);white-space:nowrap}
.cart-remove{background:rgba(255,77,77,0.12);border:1px solid rgba(255,77,77,0.3);color:var(--red);border-radius:8px;padding:6px 8px;font-size:11px;font-weight:700;cursor:pointer}
.cart-tools{display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.qty-stepper{display:inline-flex;align-items:center;border:1px solid var(--border);border-radius:999px;overflow:hidden;background:rgba(255,255,255,.04)}
.qty-stepper button{width:30px;height:30px;border:0;background:transparent;color:var(--text);font-weight:900;cursor:pointer}
.qty-stepper span{min-width:34px;text-align:center;font-size:12px;font-weight:800;font-family:var(--font-head)}
.cliente-badge{font-size:10px;color:var(--accent);font-weight:700;text-transform:uppercase;letter-spacing:.04em;margin-bottom:2px}
.venda-detalhes{font-size:11px;color:var(--muted);margin-top:4px;line-height:1.45}
.form-group{margin-bottom:14px}
.form-label{font-size:12px;color:var(--muted);margin-bottom:6px;display:block;font-weight:500}
.form-input{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:12px 14px;color:var(--text);font-size:15px;font-family:var(--font-body);outline:none;transition:border .2s}
.form-input:focus{border-color:rgba(240,165,0,0.5)}
select.form-input option{background:var(--surface2)}
.btn{width:100%;padding:14px;border-radius:12px;border:none;font-size:15px;font-weight:600;font-family:var(--font-head);cursor:pointer;transition:transform .1s}
.btn:active{transform:scale(0.98)}
.btn-accent{background:var(--accent);color:#0f1923}
.btn-outline{background:transparent;border:1px solid var(--border);color:var(--text)}
.btn-danger{background:rgba(255,77,77,0.15);color:var(--red);border:1px solid rgba(255,77,77,0.3)}
.btn-sm{padding:8px 16px;width:auto;font-size:12px;border-radius:8px}
.empty{color:var(--muted);font-size:13px;text-align:center;padding:20px}
/* PAGAMENTO SELECTOR */
.pag-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px}
.pag-btn{padding:10px 6px;border-radius:10px;border:1px solid var(--border);background:var(--surface2);color:var(--muted);font-size:12px;font-weight:600;font-family:var(--font-head);cursor:pointer;text-align:center;transition:all .15s}
.pag-btn.selected-cash{background:rgba(175,169,236,0.15);border-color:#afa9ec;color:#afa9ec}
.pag-btn.selected-mpesa{background:rgba(45,206,122,0.15);border-color:var(--green);color:var(--green)}
.pag-btn.selected-emola{background:rgba(240,165,0,0.15);border-color:var(--yellow);color:var(--yellow)}
.venda-layout{display:grid;gap:14px}
.venda-layout{max-width:920px;margin:0 auto}
.venda-search-wrap{position:relative}
.venda-prod-results{display:grid;gap:8px;margin-top:10px}
.venda-prod-card{
  display:grid;
  grid-template-columns:1fr auto;
  align-items:center;
  gap:14px;
  padding:15px;
  border:1px solid rgba(255,255,255,.14);
  border-radius:20px;
  background:linear-gradient(135deg,rgba(255,255,255,.075),rgba(255,255,255,.035));
  cursor:pointer;
  transition:transform .15s ease,border-color .15s ease,background .15s ease
}
.venda-prod-card:hover{transform:translateY(-1px);border-color:rgba(255,178,26,.45);background:rgba(255,178,26,.09)}
.venda-prod-card:active{transform:scale(.985)}
.venda-prod-name{font-size:16px;font-weight:900;font-family:var(--font-head);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#fff;letter-spacing:-.02em}
.venda-prod-meta{font-size:12px;color:#c6d3df;margin-top:5px;font-weight:700}
.venda-prod-price{font-size:15px;font-weight:900;font-family:var(--font-head);color:#5effa8;text-align:right;white-space:nowrap}
.venda-prod-add{margin-top:6px;font-size:11px;color:var(--accent);font-weight:900;text-transform:uppercase;letter-spacing:.05em;text-align:right}
.venda-select-fallback{display:none}
.venda-qty-line{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:10px 12px;
  border:1px solid var(--border);
  border-radius:16px;
  background:rgba(255,255,255,.035)
}
.venda-qty-line>div:first-child{flex:1}
.venda-qty-line .form-label{margin-bottom:4px}
.venda-qty-line .form-input{max-width:110px;padding:10px 12px}
.qty-big{display:flex;align-items:center;gap:8px}
.qty-big button{
  width:42px;height:42px;border-radius:14px;border:1px solid var(--border);
  background:rgba(255,255,255,.055);color:var(--text);font-size:22px;font-weight:900;cursor:pointer
}
.venda-help{
  margin-top:8px;
  color:var(--muted);
  font-size:12px;
  line-height:1.45
}
.venda-cart-card{padding:14px!important}
.venda-cart-title{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:10px
}
.venda-cart-title strong{font-family:var(--font-head);font-size:14px}
.venda-cart-title span{font-size:11px;color:var(--muted)}
.cart-tabs{
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding:2px 0 10px;
  margin-bottom:8px
}
.cart-tab{
  display:flex;
  align-items:center;
  gap:7px;
  flex:0 0 auto;
  border:1px solid var(--border);
  border-radius:999px;
  background:rgba(255,255,255,.045);
  color:var(--muted);
  padding:8px 10px;
  font-size:11px;
  font-weight:900;
  font-family:var(--font-head);
  cursor:pointer;
  user-select:none
}
.cart-tab.active{
  background:rgba(255,178,26,.15);
  color:var(--accent);
  border-color:rgba(255,178,26,.35)
}
.cart-tab-count{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-width:20px;
  height:20px;
  padding:0 6px;
  border-radius:999px;
  background:rgba(255,255,255,.09);
  color:#fff;
  font-size:10px
}
.cart-tab-close{
  border:0;
  background:rgba(255,77,77,.14);
  color:var(--red);
  width:20px;
  height:20px;
  border-radius:50%;
  cursor:pointer;
  font-weight:900
}
.venda-summary{
  position:sticky;
  bottom:calc(86px + env(safe-area-inset-bottom));
  z-index:25;
  margin:14px -4px 0;
  padding:14px;
  border:1px solid rgba(255,178,26,.2);
  border-radius:18px;
  background:linear-gradient(135deg,rgba(20,30,42,.96),rgba(13,20,29,.96));
  box-shadow:0 14px 36px rgba(0,0,0,.34);
  backdrop-filter:blur(16px)
}
.venda-summary-top{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:10px}
.venda-summary-label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;font-weight:900}
.venda-summary-total{font-size:24px;font-weight:900;font-family:var(--font-head);color:var(--accent);letter-spacing:-.04em}
.venda-summary-actions{display:grid;grid-template-columns:1fr 1.5fr;gap:8px}
.venda-summary-actions .btn{min-height:44px;padding:12px;font-size:13px}
.qty-modal-overlay{
  display:none;
  position:fixed;
  inset:0;
  z-index:2800;
  background:rgba(5,8,12,.82);
  backdrop-filter:blur(16px);
  align-items:center;
  justify-content:center;
  padding:18px
}
.qty-modal-overlay.open{display:flex}
.qty-modal{
  width:min(420px,100%);
  background:linear-gradient(180deg,#172433,#0f1822);
  border:1px solid rgba(255,255,255,.14);
  border-radius:28px;
  box-shadow:0 24px 80px rgba(0,0,0,.45);
  padding:20px
}
.qty-modal-kicker{font-size:11px;color:var(--accent);text-transform:uppercase;letter-spacing:.08em;font-weight:900;font-family:var(--font-head);margin-bottom:8px}
.qty-modal-name{font-size:22px;font-weight:900;font-family:var(--font-head);line-height:1.15;color:#fff;margin-bottom:8px}
.qty-modal-meta{display:flex;justify-content:space-between;gap:10px;color:#c6d3df;font-size:13px;font-weight:800;margin-bottom:18px}
.qty-modal-control{display:grid;grid-template-columns:58px 1fr 58px;gap:10px;align-items:center;margin-bottom:14px}
.qty-modal-control button{
  height:58px;border:1px solid rgba(255,255,255,.14);border-radius:18px;background:rgba(255,255,255,.07);
  color:#fff;font-size:28px;font-weight:900;cursor:pointer
}
.qty-modal-control input{
  height:58px;text-align:center;border-radius:18px;border:1px solid rgba(255,178,26,.4);
  background:rgba(255,178,26,.08);color:#fff;font-size:24px;font-weight:900;font-family:var(--font-head);outline:none
}
.qty-modal-total{
  display:flex;justify-content:space-between;align-items:center;
  padding:12px 14px;border-radius:16px;background:rgba(255,255,255,.055);margin-bottom:14px
}
.qty-modal-total span:first-child{font-size:12px;color:var(--muted);font-weight:800;text-transform:uppercase}
.qty-modal-total span:last-child{font-size:20px;color:var(--green);font-weight:900;font-family:var(--font-head)}
.qty-modal-actions{display:grid;grid-template-columns:1fr 1.5fr;gap:10px}
.pos-actions{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
  margin-bottom:12px
}
.pos-chip{
  border:1px solid var(--border);
  background:rgba(255,255,255,.05);
  color:var(--text);
  border-radius:14px;
  padding:11px 8px;
  font-family:var(--font-head);
  font-size:12px;
  font-weight:900;
  cursor:pointer
}
.pos-chip:hover{border-color:rgba(255,178,26,.35);background:rgba(255,178,26,.08)}
#recibo-overlay{
  display:none;
  position:fixed;
  inset:0;
  z-index:3000;
  background:rgba(5,8,12,.86);
  backdrop-filter:blur(18px);
  overflow:auto;
  padding:18px
}
#recibo-overlay.open{display:block}
.recibo-shell{max-width:620px;margin:0 auto}
.recibo-actions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-bottom:12px
}
.recibo-actions .btn{min-height:44px;font-size:13px}
.recibo-a5{
  background:#fff;
  color:#111;
  width:148mm;
  min-height:210mm;
  max-width:100%;
  margin:0 auto;
  padding:12mm;
  border-radius:10px;
  box-shadow:0 20px 60px rgba(0,0,0,.35);
  font-family:Arial,Helvetica,sans-serif
}
.recibo-head{text-align:center;border-bottom:2px solid #111;padding-bottom:8px;margin-bottom:10px}
.recibo-logo{width:54px;height:54px;object-fit:contain;margin-bottom:4px}
.recibo-title{font-size:18px;font-weight:900;text-transform:uppercase;letter-spacing:.04em}
.recibo-sub{font-size:11px;margin-top:3px;color:#333}
.recibo-meta{display:grid;grid-template-columns:1fr 1fr;gap:6px 12px;font-size:11px;margin:10px 0}
.recibo-line{display:flex;justify-content:space-between;gap:8px;border-bottom:1px dashed #bbb;padding:4px 0}
.recibo-line strong{font-weight:800}
.recibo-table{width:100%;border-collapse:collapse;margin-top:10px;font-size:11px}
.recibo-table th{background:#f0f0f0;text-align:left;border:1px solid #ccc;padding:5px}
.recibo-table td{border:1px solid #ddd;padding:5px;vertical-align:top}
.recibo-table .num{text-align:right;white-space:nowrap}
.recibo-total-box{margin-top:10px;border-top:2px solid #111;padding-top:8px}
.recibo-total-row{display:flex;justify-content:space-between;font-size:13px;margin:4px 0}
.recibo-total-row.big{font-size:18px;font-weight:900}
.recibo-footer{text-align:center;font-size:10px;color:#333;margin-top:18px;border-top:1px dashed #aaa;padding-top:8px;line-height:1.4}
@media print{
  @page{size:A5 portrait;margin:0}
  body.printing-recibo{background:#fff!important;overflow:visible!important}
  body.printing-recibo *{visibility:hidden!important}
  body.printing-recibo #recibo-overlay,body.printing-recibo #recibo-overlay *{visibility:visible!important}
  body.printing-recibo #recibo-overlay{display:block!important;position:absolute!important;inset:0!important;background:#fff!important;padding:0!important;overflow:visible!important}
  body.printing-recibo .recibo-shell{max-width:none!important;margin:0!important}
  body.printing-recibo .recibo-actions{display:none!important}
  body.printing-recibo .recibo-a5{width:148mm!important;min-height:210mm!important;box-shadow:none!important;border-radius:0!important;margin:0!important;padding:10mm!important}
}
@media(min-width:900px){
  .venda-layout{grid-template-columns:minmax(0,1fr);align-items:start}
  .venda-summary{bottom:24px}
}
/* TROCO */
.troco-box{background:var(--surface2);border-radius:12px;padding:14px;margin-bottom:14px}
.troco-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.troco-row:last-child{margin-bottom:0}
.troco-label{font-size:12px;color:var(--muted)}
.troco-val{font-size:15px;font-weight:700;font-family:var(--font-head)}
.troco-val.big{font-size:22px;color:var(--green)}
.troco-val.neg{color:var(--red)}
/* LUCRO CARD */
.lucro-card{background:linear-gradient(135deg,rgba(45,206,122,0.1),rgba(45,206,122,0.05));border:1px solid rgba(45,206,122,0.3);border-radius:16px;padding:16px;margin-bottom:12px}
.lucro-title{font-size:11px;font-weight:700;color:var(--green);letter-spacing:.08em;text-transform:uppercase;margin-bottom:12px;font-family:var(--font-head)}
.lucro-row{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid rgba(255,255,255,0.05)}
.lucro-row:last-child{border-bottom:none;padding-top:10px;margin-top:4px}
.lucro-row-label{font-size:13px;color:var(--muted)}
.lucro-row-val{font-size:13px;font-weight:600;font-family:var(--font-head)}
.lucro-total-label{font-size:14px;font-weight:700;color:var(--text)}
.lucro-total-val{font-size:20px;font-weight:800;font-family:var(--font-head);color:var(--green)}
.ger-kpi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0}
.ger-kpi{background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:10px}
.ger-kpi-label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px}
.ger-kpi-val{font-size:16px;font-weight:800;font-family:var(--font-head);line-height:1.1}
@media (max-width:380px){.ger-kpi-grid{grid-template-columns:1fr 1fr}}

.venda-actions{display:flex;gap:6px;justify-content:flex-end;margin-top:8px;flex-wrap:wrap}
.venda-mini-btn{padding:6px 9px;border-radius:8px;border:1px solid var(--border);background:var(--surface2);color:var(--text);font-size:10px;font-weight:700;font-family:var(--font-head);cursor:pointer}
.venda-mini-btn.edit{border-color:rgba(240,165,0,0.35);color:var(--accent)}
.venda-mini-btn.del{border-color:rgba(255,77,77,0.35);color:var(--red)}
.edit-venda-item{background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:10px;margin-bottom:10px}
.edit-venda-row{display:grid;grid-template-columns:1fr 82px 92px;gap:8px;align-items:end}
@media(max-width:380px){.edit-venda-row{grid-template-columns:1fr}.venda-actions{justify-content:flex-start}}

/* MODAL */
#modal-overlay{display:none;position:absolute;inset:0;background:rgba(0,0,0,0.75);z-index:100;align-items:flex-end}
#modal-overlay.open{display:flex}
#modal-box{background:var(--surface);border-radius:24px 24px 0 0;padding:20px;width:100%;max-height:90vh;overflow-y:auto;animation:slideUp .25s ease}
@keyframes slideUp{from{transform:translateY(60px);opacity:0}to{transform:translateY(0);opacity:1}}
#modal-title{font-family:var(--font-head);font-size:17px;font-weight:700;margin-bottom:18px;display:flex;justify-content:space-between;align-items:center}
#modal-close{background:var(--surface2);border:none;color:var(--muted);width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center}
.user-profile-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:14px 16px;margin-bottom:10px;display:flex;align-items:center;gap:14px}
.user-profile-card .ava{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;font-family:var(--font-head);flex-shrink:0}
.user-profile-card .uname{font-size:14px;font-weight:600;font-family:var(--font-head)}
.user-profile-card .urole{font-size:11px;color:var(--muted);margin-top:2px}
.user-profile-card .ustats{font-size:11px;color:var(--green);margin-top:3px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}

.ger-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
.ger-tab{background:var(--surface2);border:1px solid var(--border);color:var(--muted);padding:10px 6px;border-radius:10px;font-size:11px;font-weight:700;font-family:var(--font-head);cursor:pointer}
.ger-tab.active{background:var(--accent);color:#0f1923;border-color:var(--accent)}
.ger-folder-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}
.ger-folder-title{font-size:12px;font-weight:700;color:var(--text);font-family:var(--font-head)}
.ger-folder-meta{font-size:11px;color:var(--muted)}

/* REFORMA VISUAL — balcão moderno */
:root{
  --bg:#0b1118;
  --surface:#121b26;
  --surface2:#1a2634;
  --surface3:#223246;
  --border:rgba(255,255,255,.095);
  --accent:#ffb21a;
  --accent2:#ff7a1a;
  --text:#f7fafc;
  --muted:#9badbf;
  --shadow:0 18px 48px rgba(0,0,0,.28);
  --soft-shadow:0 10px 30px rgba(0,0,0,.18)
}
html,body{
  background:
    radial-gradient(circle at 12% 10%,rgba(255,178,26,.13),transparent 28%),
    radial-gradient(circle at 90% 8%,rgba(45,206,122,.08),transparent 28%),
    linear-gradient(135deg,#081018 0%,#111b27 54%,#0b1118 100%);
}
#app{background:linear-gradient(180deg,rgba(255,255,255,.02),rgba(255,255,255,0));}
#login-screen{
  background:
    linear-gradient(135deg,rgba(8,16,24,.94),rgba(15,25,35,.9)),
    radial-gradient(circle at top right,rgba(255,178,26,.18),transparent 36%);
  justify-content:center;
}
#login-screen::before{
  content:'';
  position:absolute;
  inset:18px;
  border:1px solid rgba(255,255,255,.055);
  border-radius:30px;
  pointer-events:none
}
#login-screen>div[style*="position:relative"]{
  max-width:390px;
  padding:26px 22px 30px!important;
  border:1px solid rgba(255,255,255,.1);
  border-radius:28px;
  background:linear-gradient(180deg,rgba(18,27,38,.88),rgba(10,16,24,.72));
  box-shadow:var(--shadow);
  backdrop-filter:blur(16px)
}
#login-screen img[src="logo.jpg"]{
  border-radius:28px!important;
  background:rgba(255,255,255,.03);
  border:1px solid rgba(255,178,26,.18);
  padding:8px
}
.login-section-label{
  background:rgba(255,178,26,.11);
  color:var(--accent);
  border:1px solid rgba(255,178,26,.18);
  border-radius:999px;
  padding:8px 12px;
  margin-bottom:4px
}
.auth-field label,.form-label{letter-spacing:.03em;text-transform:uppercase;font-size:10px}
.auth-field input,.form-input{
  background:rgba(255,255,255,.055);
  border-color:rgba(255,255,255,.1);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.04)
}
.auth-field input:focus,.form-input:focus{
  border-color:rgba(255,178,26,.75);
  box-shadow:0 0 0 4px rgba(255,178,26,.09)
}
#auth-submit,.btn-accent{
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  box-shadow:0 10px 24px rgba(255,122,26,.22);
  color:#101620
}
#auth-submit:hover,.btn-accent:hover{filter:brightness(1.06)}
#sync-bar{
  border-bottom:1px solid rgba(255,255,255,.06);
  letter-spacing:.02em;
  font-weight:700
}
#header{
  background:rgba(10,17,25,.86);
  backdrop-filter:blur(18px);
  box-shadow:0 10px 30px rgba(0,0,0,.16)
}
#header-left img{
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,178,26,.16);
  padding:2px
}
#btn-logout,#btn-fullscreen{
  transition:transform .15s ease,background .15s ease,border-color .15s ease
}
#btn-logout:hover,#btn-fullscreen:hover{transform:translateY(-1px)}
#nav{
  background:rgba(12,19,28,.92);
  backdrop-filter:blur(20px);
  box-shadow:0 -14px 36px rgba(0,0,0,.22)
}
.nav-btn{
  border-radius:14px;
  transition:background .15s ease,color .15s ease,transform .15s ease
}
.nav-btn.active{
  background:rgba(255,178,26,.12);
  color:var(--accent)
}
.nav-btn:active{transform:translateY(1px) scale(.98)}
.sec-title{
  display:flex;
  align-items:center;
  gap:8px;
  color:#c4d0dd
}
.sec-title::before{
  content:'';
  width:8px;
  height:8px;
  border-radius:50%;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  box-shadow:0 0 16px rgba(255,178,26,.5)
}
#dash-welcome{
  position:relative;
  overflow:hidden;
  background:
    radial-gradient(circle at right top,rgba(255,178,26,.19),transparent 35%),
    linear-gradient(135deg,#1d2c3e,#111b26)!important;
  border-color:rgba(255,178,26,.16)!important;
  box-shadow:var(--soft-shadow)
}
#dash-welcome::after{
  content:'';
  position:absolute;
  right:-45px;
  bottom:-60px;
  width:170px;
  height:170px;
  border-radius:50%;
  border:28px solid rgba(255,255,255,.035)
}
#dash-welcome img{
  background:rgba(255,255,255,.05);
  border:1px solid rgba(255,178,26,.18);
  padding:4px
}
.quick-actions{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:10px;
  margin:0 0 16px
}
.quick-action{
  border:1px solid var(--border);
  border-radius:16px;
  padding:13px 12px;
  background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.025));
  color:var(--text);
  font-family:var(--font-head);
  font-size:12px;
  font-weight:800;
  cursor:pointer;
  text-align:left;
  min-height:68px;
  transition:transform .15s ease,border-color .15s ease,background .15s ease
}
.quick-action span{
  display:block;
  font-size:20px;
  margin-bottom:7px
}
.quick-action:hover{
  transform:translateY(-2px);
  border-color:rgba(255,178,26,.35);
  background:linear-gradient(180deg,rgba(255,178,26,.12),rgba(255,255,255,.035))
}
.stat-card,.card,.lucro-card,.troco-box,.user-profile-card,.ger-kpi,.alert{
  box-shadow:var(--soft-shadow);
  background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.025));
  border-color:var(--border)
}
.stat-card{
  position:relative;
  overflow:hidden;
  min-height:96px
}
.stat-card::after{
  content:'';
  position:absolute;
  right:-22px;
  top:-24px;
  width:78px;
  height:78px;
  border-radius:50%;
  background:rgba(255,255,255,.035)
}
.stat-label{font-weight:800;text-transform:uppercase;letter-spacing:.06em;font-size:10px}
.stat-val{letter-spacing:-.04em}
.prod-row,.venda-row,.cart-row,.rel-row{
  border-bottom-color:rgba(255,255,255,.07);
  transition:background .15s ease,transform .15s ease
}
.prod-row:hover,.venda-row:hover{
  background:rgba(255,255,255,.03);
  border-radius:12px;
  padding-left:8px;
  padding-right:8px
}
.prod-icon{
  background:linear-gradient(135deg,rgba(255,178,26,.12),rgba(255,255,255,.05));
  border:1px solid rgba(255,178,26,.13)
}
.badge,.badge-ok,.badge-low,.badge-out,.badge-mpesa,.badge-emola,.badge-cash{
  border:1px solid currentColor;
  border-color:color-mix(in srgb,currentColor 28%,transparent)
}
.pag-btn{
  min-height:48px;
  background:rgba(255,255,255,.055);
  transition:transform .15s ease,border-color .15s ease,background .15s ease
}
.pag-btn:hover{transform:translateY(-1px);border-color:rgba(255,255,255,.18)}
.btn{
  min-height:48px;
  transition:transform .15s ease,filter .15s ease,box-shadow .15s ease
}
.btn:hover{transform:translateY(-1px)}
.btn-outline:hover{border-color:rgba(255,178,26,.35);background:rgba(255,178,26,.08)}
#modal-box{
  border:1px solid rgba(255,255,255,.1);
  box-shadow:var(--shadow);
  background:linear-gradient(180deg,#172231,#101821)
}
#modal-close:hover{background:rgba(255,77,77,.12);color:var(--red)}
@media(max-width:430px){
  .quick-actions{grid-template-columns:1fr}
  .quick-action{min-height:0;display:flex;align-items:center;gap:10px}
  .quick-action span{margin:0}
  #login-screen{padding:18px 14px}
  #login-screen>div[style*="position:relative"]{padding:20px 16px 24px!important}
}

/* DESKTOP */
@media(min-width:900px){
  html,body{overflow:hidden}
  #app{max-width:none;width:100%;height:100dvh;margin:0;padding-left:230px}
  #login-screen{position:fixed;left:0;padding-top:48px}
  #login-screen>div[style*="position:relative"]{max-width:460px}
  #pin-overlay{position:fixed}
  #nav{
    top:0;bottom:0;left:0;transform:none;
    width:230px;max-width:none;height:100dvh;
    flex-direction:column;align-items:stretch;
    padding:24px 14px;background:linear-gradient(180deg,#121e2b 0%,#0c151f 100%);
    border-top:0;border-right:1px solid var(--border);
    box-shadow:8px 0 30px rgba(0,0,0,.18)
  }
  #nav::before{
    content:'FERRAGEM PÓ CINZENTO';
    white-space:normal;
    display:flex;
    align-items:center;
    min-height:68px;
    font-family:var(--font-head);
    font-size:15px;
    line-height:1.45;
    font-weight:800;
    color:var(--text);
    padding:8px 12px 18px;
    margin-bottom:10px;
    border-bottom:1px solid var(--border);
    letter-spacing:.025em;
    overflow-wrap:normal;
    word-break:keep-all
  }
  .nav-btn{flex:0 0 auto;flex-direction:row;justify-content:flex-start;gap:12px;padding:12px 14px;margin-bottom:5px;border-radius:11px;font-size:12px;font-family:var(--font-head);font-weight:700}
  .nav-btn:hover{background:var(--surface2);color:var(--text)}
  .nav-btn.active{background:rgba(240,165,0,.13);color:var(--accent);box-shadow:inset 3px 0 0 var(--accent)}
  .nav-btn svg{width:19px;height:19px}
  #sync-bar{min-height:30px}
  #header{padding:14px 28px;background:rgba(15,25,35,.96);box-shadow:0 5px 20px rgba(0,0,0,.12)}
  #header-left h2{font-size:20px}
  #btn-fullscreen{display:flex}
  #content{padding:24px 28px 36px;max-width:none}
  .screen.on{max-width:1320px;width:100%;margin:0 auto}
  .screen.on *{min-width:0}
  .stats-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  .stats-grid-3{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
  .stat-card{padding:18px;border-radius:16px}
  .stat-label,.stat-val,.ger-kpi-label,.ger-kpi-val,.prod-name,.venda-name,.rel-name,.rel-sub{overflow-wrap:anywhere;word-break:normal}
  .stat-label{line-height:1.35;min-height:30px}
  .stat-val{font-size:clamp(20px,2vw,28px);line-height:1.15}
  .card{overflow:hidden}
  .prod-row,.venda-row,.rel-row{min-width:0}
  .prod-info,.venda-info,.rel-info{min-width:0;overflow:hidden}
  .prod-stock,.venda-total,.rel-total{max-width:38%;overflow-wrap:anywhere}
  #screen-dashboard>div:first-child{flex-wrap:wrap;row-gap:12px}
  #screen-dashboard>div:first-child>div:nth-child(2){min-width:240px}
  #header-left{min-width:0;overflow:hidden;flex:1}
  #header-left>div:first-child{min-width:0;flex-wrap:nowrap}
  #header-left h2{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3;display:block}
  #header-left .huser{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.4}
  .header-actions{flex-shrink:0}
  #screen-vender{max-width:1050px}
  #screen-aluguel{max-width:1200px}
  .ger-kpi-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
  .ger-tabs{grid-template-columns:repeat(3,minmax(160px,1fr))}
  .form-row{gap:14px}
  #modal-overlay{position:fixed;align-items:center;justify-content:center}
  #modal-box{max-width:680px;border-radius:22px;max-height:88vh}
}
@media(min-width:1180px){
  .stats-grid{grid-template-columns:repeat(4,minmax(0,1fr))}
}
@media(min-width:900px) and (max-width:1050px){
  #app{padding-left:205px}
  #nav{width:205px;padding-left:10px;padding-right:10px}
  #content{padding-left:18px;padding-right:18px}
  #header{padding-left:18px;padding-right:18px}
  #btn-fullscreen{padding:8px 10px}
  #btn-fullscreen span{display:none}
}
@media(min-width:900px){
  :fullscreen #app{width:100vw;height:100vh}
  :fullscreen #content{height:auto}
  :fullscreen .screen.on{max-width:1320px}
}

</style>
</head>
<body>
<div id="app">

<!-- LOGIN -->
<div id="login-screen">
  <!-- Animated background dots -->
  <div style="position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:0">
    <div style="position:absolute;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(240,165,0,0.08),transparent);top:-80px;right:-80px"></div>
    <div style="position:absolute;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,rgba(45,206,122,0.06),transparent);bottom:100px;left:-60px"></div>
  </div>
  <div style="position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;width:100%;padding:0 0 32px">
    <!-- Logo grande -->
    <div style="margin-bottom:6px;margin-top:8px">
      <img src="logo.jpg" style="width:140px;height:140px;object-fit:contain;filter:drop-shadow(0 8px 24px rgba(240,165,0,0.25))">
    </div>
    <h1 style="font-family:var(--font-head);font-size:26px;font-weight:800;text-align:center;line-height:1.2">Ferragem <span style="color:var(--accent)">Pó Cinzento</span></h1>
    <div style="font-size:11px;color:var(--muted);margin-top:4px;text-align:center;letter-spacing:.05em">GESTÃO DE STOCK · ALUGUER DE MATERIAIS</div>
    <div style="font-size:10px;color:var(--accent);margin-top:3px;text-align:center">Responsável: Elton F. Mandlate</div>

    <!-- Motivação -->
    <div style="margin:18px 0 22px;padding:12px 18px;background:rgba(240,165,0,0.08);border:1px solid rgba(240,165,0,0.2);border-radius:12px;width:100%;text-align:center">
      <div style="font-size:16px;margin-bottom:4px" id="login-emoji">💪</div>
      <div style="font-size:12px;color:var(--accent);font-weight:600;font-family:var(--font-head);text-align:center;line-height:1.5" id="login-frase">A carregar...</div>
      <div style="font-size:10px;color:var(--muted);margin-top:4px;font-style:italic" id="login-frase-autor">— Elton F. Mandlate</div>
    </div>

    <!-- Hora e data -->
    <div style="font-size:11px;color:var(--muted);margin-bottom:20px;text-align:center" id="login-hora"></div>

    <form class="auth-form" id="auth-form">
      <div class="login-section-label">Entrar com conta autorizada</div>
      <div class="auth-field">
        <label for="auth-email">E-mail</label>
        <input id="auth-email" name="email" type="email" autocomplete="username" required>
      </div>
      <div class="auth-field">
        <label for="auth-password">Senha</label>
        <input id="auth-password" name="password" type="password" autocomplete="current-password" minlength="8" required>
      </div>
      <div class="auth-error" id="auth-error" role="alert"></div>
      <button class="btn btn-accent" id="auth-submit" type="submit">Entrar</button>
    </form>
  </div>
</div>

<!-- SYNC BAR -->
<div id="sync-bar" class="loading" role="status" aria-live="polite">
  <div class="sync-dot"></div>
  <span id="sync-text">A ligar à base de dados...</span>
</div>

<!-- HEADER -->
<div id="header">
  <div id="header-left">
    <div style="display:flex;align-items:center;gap:8px"><img src="logo.jpg" style="width:32px;height:32px;object-fit:contain;border-radius:6px;flex-shrink:0"><h2>Ferragem <span>Pó Cinzento</span></h2></div>
    <div class="huser" id="huser-text">—</div>
  </div>
  <div class="header-actions">
  <button id="btn-fullscreen" onclick="toggleFullscreen()" title="Ocupar toda a tela">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"/></svg>
    <span id="fullscreen-label">TELA CHEIA</span>
  </button>
  <button id="btn-logout" onclick="logout()">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
    SAIR
  </button>
  </div>
</div>

<div id="content">

  <!-- DASHBOARD -->
  <div id="screen-dashboard" class="screen on">
    <!-- Welcome banner -->
    <div id="dash-welcome" style="background:linear-gradient(135deg,var(--surface2),var(--surface));border:1px solid var(--border);border-radius:18px;padding:18px;margin-bottom:16px;display:flex;align-items:center;gap:14px">
      <img src="logo.jpg" style="width:54px;height:54px;object-fit:contain;border-radius:10px;flex-shrink:0">
      <div style="flex:1;min-width:0">
        <div style="font-size:11px;color:var(--muted);font-weight:500" id="dash-saudacao">Bem-vindo</div>
        <div style="font-family:var(--font-head);font-size:17px;font-weight:800;color:var(--text);margin-top:2px" id="dash-nome-user">—</div>
        <div style="font-size:11px;color:var(--accent);margin-top:3px;line-height:1.5" id="dash-mensagem-user">A disciplina de hoje constrói a grandeza de amanhã.<br><span style="color:var(--muted);font-style:italic">— Elton F. Mandlate</span><br><span style="color:var(--text)">Bom trabalho hoje!</span></div>
      </div>
      <div style="text-align:right;flex-shrink:0">
        <div style="font-size:22px;font-weight:800;font-family:var(--font-head);color:var(--accent)" id="dash-hora-live">--:--</div>
        <div style="font-size:10px;color:var(--muted)" id="dash-data-live">—</div>
      </div>
    </div>
    <div class="quick-actions" aria-label="Atalhos rápidos">
      <button class="quick-action" onclick="goScreen('vender',document.getElementById('nav-vender'))"><span>🛒</span>Nova venda</button>
      <button class="quick-action" onclick="goScreen('stock',document.getElementById('nav-stock'))"><span>📦</span>Ver stock</button>
      <button class="quick-action" onclick="goScreen('aluguel',document.getElementById('nav-aluguel'))"><span>🚚</span>Novo aluguel</button>
    </div>
    <div class="stats-grid" id="dash-stats"></div>
    <div class="sec-title">Alertas</div>
    <div id="dash-alertas"></div>
    <div class="sec-title">Vendas de hoje</div>
    <div class="card" id="dash-vendas"></div>
    <div style="margin-top:24px;padding:14px 16px;background:var(--surface);border-left:3px solid var(--accent);border-radius:0 10px 10px 0;font-size:12px;color:var(--muted);line-height:1.6;font-style:italic">💡 O melhor atendimento é simples, claro e objectivo.</div>
  </div>

  <!-- STOCK -->
  <div id="screen-stock" class="screen">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
      <div class="sec-title" style="margin:0">Produtos</div>
      <button class="btn btn-accent btn-sm" id="btn-add-prod" style="display:none" onclick="openModal('add-prod')">+ Adicionar</button>
    </div>
    <input class="form-input" style="margin-bottom:14px" placeholder="Pesquisar..." id="search-prod" oninput="renderStock()">
    <div class="card" id="stock-list"></div>
    <div style="margin-top:24px;padding:14px 16px;background:var(--surface);border-left:3px solid var(--accent);border-radius:0 10px 10px 0;font-size:12px;color:var(--muted);line-height:1.6;font-style:italic">🤝 Um cliente satisfeito volta sempre — trata-o bem hoje.</div>
  </div>

  <!-- VENDER -->
  <div id="screen-vender" class="screen">
    <div class="sec-title">Nova venda</div>
    <div class="venda-layout">
      <div class="card">
        <div style="display:grid;grid-template-columns:1fr;gap:12px;margin-bottom:14px">
          <div>
            <label class="form-label">Cliente</label>
            <input class="form-input" id="v-cliente" placeholder="Cliente balcão / nome opcional">
          </div>
        </div>
        <div class="form-group venda-search-wrap">
          <label class="form-label">Produto</label>
          <input class="form-input" id="search-venda-prod" placeholder="Pesquisar e tocar para adicionar..." oninput="renderVenderSelect()">
          <div class="venda-help">Toque num produto para adicionar ao carrinho. Use a quantidade abaixo quando precisar adicionar mais de uma unidade por toque.</div>
          <div class="venda-prod-results" id="v-prod-results"></div>
          <select class="form-input venda-select-fallback" id="v-prod" onchange="onProdutoVendaChange();updatePreview()" oninput="onProdutoVendaChange();updatePreview()"></select>
        </div>
        <div class="form-group venda-qty-line">
          <div>
            <label class="form-label">Quantidade por toque</label>
            <input class="form-input" type="text" id="v-qty" value="1" inputmode="decimal" pattern="[0-9]+([\.,][0-9]+)?" placeholder="Ex: 1,5" oninput="updateProdutoVendaInfo();updatePreview()">
          </div>
          <div class="qty-big" aria-label="Ajustar quantidade">
            <button type="button" onclick="ajustarQtyProdutoVenda(-1)">−</button>
            <button type="button" onclick="ajustarQtyProdutoVenda(1)">+</button>
          </div>
        </div>
        <div class="troco-box" id="v-prod-info" style="display:none;margin-bottom:14px">
          <div class="troco-row">
            <span class="troco-label">Preço unitário</span>
            <span class="troco-val" id="v-preco-unit">—</span>
          </div>
          <div class="troco-row">
            <span class="troco-label">Subtotal deste produto</span>
            <span class="troco-val big" id="v-prod-subtotal">—</span>
          </div>
          <div class="troco-row">
            <span class="troco-label">Stock disponível</span>
            <span class="troco-val" id="v-prod-stock">—</span>
          </div>
        </div>
      </div>

      <div class="card venda-cart-card">
        <div class="venda-cart-title">
          <div>
            <strong>Carrinho</strong>
            <span id="venda-cart-subtitle">Venda actual</span>
          </div>
          <div style="display:flex;gap:6px;align-items:center">
            <button class="venda-mini-btn edit" type="button" onclick="novoCarrinhoVenda()">+ Carrinho</button>
            <button class="venda-mini-btn del" type="button" onclick="limparCarrinhoVenda()">Limpar</button>
          </div>
        </div>
        <div class="cart-tabs" id="cart-tabs" aria-label="Carrinhos de venda"></div>
        <div id="carrinho-venda" style="margin-bottom:0"><div class="empty">Nenhum produto adicionado</div></div>
        <!-- PAGAMENTO -->
        <div class="form-group" style="margin-top:14px">
          <label class="form-label">Forma de pagamento</label>
          <div class="pag-grid">
            <button class="pag-btn selected-cash" id="pag-cash" onclick="selectPag('cash')">💵 Numerário</button>
            <button class="pag-btn" id="pag-mpesa" onclick="selectPag('mpesa')">📱 M-Pesa</button>
            <button class="pag-btn" id="pag-emola" onclick="selectPag('emola')">📲 E-Mola</button>
          </div>
        </div>
        <!-- PREVIEW & TROCO -->
        <div id="v-preview" style="display:none">
          <div class="troco-box">
            <div class="troco-row">
              <span class="troco-label">Total da venda</span>
              <span class="troco-val" id="troco-total">0 MZN</span>
            </div>
            <div id="troco-section">
              <div class="form-group" style="margin-top:10px;margin-bottom:8px">
                <label class="form-label">Valor entregue pelo cliente (MZN)</label>
                <input class="form-input" type="number" id="v-entregue" placeholder="Ex: 500" oninput="calcTroco()" style="font-size:18px;font-weight:700;font-family:var(--font-head)">
              </div>
              <div class="pos-actions" aria-label="Atalhos de valor recebido">
                <button class="pos-chip" type="button" onclick="preencherValorEntregue('exact')">Valor exacto</button>
                <button class="pos-chip" type="button" onclick="preencherValorEntregue(500)">500</button>
                <button class="pos-chip" type="button" onclick="preencherValorEntregue(1000)">1000</button>
              </div>
              <div class="troco-row">
                <span class="troco-label">Troco a devolver</span>
                <span class="troco-val big" id="troco-val">—</span>
              </div>
            </div>
          </div>
        </div>
        <div class="venda-summary">
          <div class="venda-summary-top">
            <div>
              <div class="venda-summary-label">Total a pagar</div>
              <div class="venda-summary-total" id="venda-total-fixo">0 MZN</div>
            </div>
            <div style="text-align:right">
              <div class="venda-summary-label">Itens</div>
              <div style="font-family:var(--font-head);font-weight:900" id="venda-itens-count">0</div>
            </div>
          </div>
          <div class="venda-summary-actions">
            <button class="btn btn-outline" type="button" onclick="document.getElementById('search-venda-prod')?.focus()">+ Produto</button>
            <button class="btn btn-accent" type="button" onclick="regVenda()">Finalizar venda</button>
          </div>
        </div>
      </div>
    </div>
    <div class="sec-title" style="margin-top:4px">Histórico de hoje</div>
    <div class="card" id="hist-list"></div>
    <div style="margin-top:24px;padding:14px 16px;background:var(--surface);border-left:3px solid var(--accent);border-radius:0 10px 10px 0;font-size:12px;color:var(--muted);line-height:1.6;font-style:italic">📦 Stock organizado é dinheiro que não se perde.</div>
  </div>

  <!-- GERÊNCIA -->
  <div id="screen-gerencia" class="screen">
    <div class="sec-title">Resumo do dia</div>
    <div class="stats-grid" id="ger-stats"></div>

    <!-- LUCRO LÍQUIDO — só gerência -->
    <div class="lucro-card" id="lucro-card"></div>

    <!-- PAGAMENTOS -->
    <div class="sec-title">Pagamentos por método</div>
    <div class="stats-grid-3" id="ger-pag"></div>

    <div class="sec-title">Actividade por funcionário</div>
    <div id="ger-users"></div>

    <div class="sec-title">Pastas de vendas</div>
    <div class="card">
      <div class="ger-tabs">
        <button class="ger-tab active" id="ger-tab-hoje" onclick="selectGerTab('hoje',this)">Hoje</button>
        <button class="ger-tab" id="ger-tab-semana" onclick="selectGerTab('semana',this)">Semana</button>
        <button class="ger-tab" id="ger-tab-mes" onclick="selectGerTab('mes',this)">Mês</button>
        <button class="ger-tab" id="ger-tab-trimestre" onclick="selectGerTab('trimestre',this)">Trimestre</button>
        <button class="ger-tab" id="ger-tab-semestre" onclick="selectGerTab('semestre',this)">Semestre</button>
        <button class="ger-tab" id="ger-tab-ano" onclick="selectGerTab('ano',this)">Ano</button>
      </div>
      <div id="ger-vendas"></div>
    </div>

    <div class="sec-title">Resumo de alugueis</div>
    <div class="stats-grid-3" id="ger-aluguel-stats"></div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;margin-top:4px">
      <div class="sec-title" style="margin:0">Materiais alugáveis</div>
      <button class="btn btn-accent btn-sm" onclick="openModal('add-material')">+ Adicionar</button>
    </div>
    <div class="card" id="ger-materiais-list"></div>
    <div class="sec-title">Alertas de stock</div>
    <div class="card" id="ger-stock-alerts"></div>

    <div style="margin-top:8px;display:flex;flex-direction:column;gap:10px">
      <button class="btn btn-accent" onclick="openModal('add-prod')">+ Adicionar produto ao stock</button>
      <button class="btn" style="background:rgba(175,169,236,0.15);border:1px solid rgba(175,169,236,0.3);color:#afa9ec;padding:14px;border-radius:14px;font-size:14px;font-weight:700;font-family:var(--font-head);cursor:pointer" onclick="abrirRelatorios()">📊 Ver Relatórios (dia / semana / mês)</button>
      <button class="btn btn-danger" onclick="fecharDia()">⬇️ Exportar relatório do dia</button>
    </div>
    <div style="margin-top:24px;padding:14px 16px;background:var(--surface);border-left:3px solid var(--accent);border-radius:0 10px 10px 0;font-size:12px;color:var(--muted);line-height:1.6;font-style:italic">⏱️ Rapidez e honestidade constroem confiança.</div>
  </div>

  <!-- ALUGUEL -->
  <div id="screen-aluguel" class="screen">
    <div class="sec-title">Novo aluguel</div>
    <div class="card">
      <div class="form-group">
        <label class="form-label">Material / Máquina</label>
        <select class="form-input" id="al-material" oninput="updateAluguelPreview()"></select>
      </div>
      <div class="form-group">
        <label class="form-label">Nome do cliente</label>
        <input class="form-input" type="text" id="al-cliente" placeholder="Nome completo do cliente">
      </div>
      <div class="form-group">
        <label class="form-label">Contacto do cliente</label>
        <input class="form-input" type="tel" id="al-contacto" placeholder="Ex: 84 123 4567">
      </div>
      <div class="form-group">
        <label class="form-label">Número de dias</label>
        <input class="form-input" type="number" id="al-dias" value="1" min="1" oninput="updateAluguelPreview()">
      </div>
      <div class="form-group">
        <label class="form-label">Data de início</label>
        <input class="form-input" type="date" id="al-inicio" id="al-inicio">
      </div>
      <div class="form-group">
        <label class="form-label">Forma de pagamento</label>
        <div class="pag-grid">
          <button class="pag-btn selected-cash" id="al-pag-cash" onclick="selectAlPag('cash')">💵 Numerário</button>
          <button class="pag-btn" id="al-pag-mpesa" onclick="selectAlPag('mpesa')">📱 M-Pesa</button>
          <button class="pag-btn" id="al-pag-emola" onclick="selectAlPag('emola')">📲 E-Mola</button>
        </div>
      </div>
      <div id="al-preview" style="display:none">
        <div class="troco-box" style="margin-bottom:14px">
          <div class="troco-row">
            <span class="troco-label">Material</span>
            <span class="troco-val" id="al-prev-material" style="font-size:13px">—</span>
          </div>
          <div class="troco-row">
            <span class="troco-label">Preço/dia</span>
            <span class="troco-val" id="al-prev-preco">—</span>
          </div>
          <div class="troco-row">
            <span class="troco-label">Duração</span>
            <span class="troco-val" id="al-prev-dias">—</span>
          </div>
          <div class="troco-row">
            <span class="troco-label">Data devolução</span>
            <span class="troco-val" id="al-prev-devol" style="color:var(--yellow)">—</span>
          </div>
          <div class="troco-row" style="margin-top:6px;border-top:1px solid var(--border);padding-top:8px">
            <span class="troco-label" style="font-weight:600;color:var(--text)">Total a pagar</span>
            <span class="troco-val" style="font-size:22px;color:var(--green)" id="al-prev-total">—</span>
          </div>
        </div>
      </div>
      <button class="btn btn-accent" onclick="regAluguel()">Confirmar aluguel</button>
    </div>
    <div class="sec-title" style="margin-top:4px">Alugueis activos</div>
    <div id="al-activos"></div>
    <div class="sec-title">Histórico de alugueis</div>
    <div class="card" id="al-historico"></div>
    <div style="margin-top:24px;padding:14px 16px;background:var(--surface);border-left:3px solid var(--accent);border-radius:0 10px 10px 0;font-size:12px;color:var(--muted);line-height:1.6;font-style:italic">🔑 Cada aluguel é um contrato de confiança — regista sempre tudo com rigor.</div>
  </div>

</div>

<div id="nav">
  <button class="nav-btn active" id="nav-dash" onclick="goScreen('dashboard',this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
    Painel

async function regVenda(){
  if(!carrinhoVenda.length){showToast('Adiciona pelo menos um produto','red');return;}
  if(!dbOk){showToast('❌ Sem ligação. Tenta novamente.','red');return;}
  for(const item of carrinhoVenda){const p=produtos.find(x=>x.id===item.id); if(!p||Number(item.stock_qty||item.qty)>Number(p.qty||0)){showToast('Stock insuficiente: '+item.nome,'red');return;}}
  let cliente=(document.getElementById('v-cliente')?.value||'').trim(); if(!cliente)cliente=await gerarClienteAutomatico();
  const itens=carrinhoVenda.map(i=>({id:i.id,nome:i.nome,qty:i.qty,stock_qty:i.qty,preco_unit:i.preco_unit,preco_compra_unit:i.preco_compra_unit,subtotal:i.subtotal}));
  const totalVenda=itens.reduce((a,i)=>a+Number(i.subtotal||0),0);
  const entregue=pagamento==='cash'?Number(document.getElementById('v-entregue')?.value||0):0;
  if(pagamento==='cash' && entregue && entregue<totalVenda){showToast('Valor entregue insuficiente','red');return;}
  const {data,error}=await db.rpc('registar_venda_segura',{
    p_cliente:cliente,
    p_pagamento:pagamento,
    p_itens:itens.map(i=>({produto_id:i.id,qty:Number(i.qty)}))
  });
  if(error){
    console.error('Erro ao registar venda:',error);
    const message=error.message||error.details||'Erro ao registar venda com segurança';
    showToast(message,'red');
    return;
  }
  const recibo={
    id:data||Date.now(),
    data:new Date().toISOString(),
    cliente,
    funcionario:currentUser?.name||'—',
    pagamento,
    itens,
    total:totalVenda,
    entregue:pagamento==='cash'?(entregue||totalVenda):0
  };
  finalizarCarrinhoAtivoAposVenda();
  await loadProdutos();await loadVendas(); renderAll(); showToast('Venda finalizada!','green'); abrirReciboVenda(recibo);
}


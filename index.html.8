  }).filter(i=>i.id&&i.qty>0);
}
function calcEditVendaTotal(){
  const itens=lerItensVendaEditada();
  const total=itens.reduce((a,i)=>a+Number(i.subtotal||0),0);
  const qtd=itens.reduce((a,i)=>a+Number(i.qty||0),0);
  const el=document.getElementById('edit-venda-total');
  if(el)el.textContent=`${total.toLocaleString()} MZN · ${formatQty(qtd)} item(ns)`;
}
async function ajustarStockPorVenda(oldItens,newItens){
  const ids=[...new Set([...oldItens.map(i=>i.id),...newItens.map(i=>i.id)].filter(Boolean))];
  for(const id of ids){
    const antigo=oldItens.filter(i=>Number(i.id)===Number(id)).reduce((a,i)=>a+Number(i.stock_qty||i.qty||0),0);
    const novo=newItens.filter(i=>Number(i.id)===Number(id)).reduce((a,i)=>a+Number(i.stock_qty||i.qty||0),0);
    const p=produtos.find(x=>Number(x.id)===Number(id));
    if(!p)continue;
    const novaQty=Number(p.qty||0)+antigo-novo;
    if(novaQty<0){showToast('Stock insuficiente para editar venda','red');return false;}
    const {error}=await db.from('produtos').update({qty:novaQty}).eq('id',id);
    if(error){showToast('Erro ao actualizar stock','red');return false;}
  }
  return true;
}
async function saveVendaEditada(id){
  if(currentUser?.role!=='gerencia'){showToast('Apenas a gerência pode editar vendas','red');return;}
  if(!dbOk){showToast('❌ Sem ligação. Tenta novamente.','red');return;}
  const venda=getVendaById(id); if(!venda){showToast('Venda não encontrada','red');return;}
  const oldItens=getVendaItensParaEdicao(venda);
  const newItens=lerItensVendaEditada();
  if(!newItens.length){showToast('A venda precisa ter pelo menos um produto','red');return;}
  const ok=await ajustarStockPorVenda(oldItens,newItens); if(!ok)return;
  const total=newItens.reduce((a,i)=>a+Number(i.subtotal||0),0);
  const qtdTotal=newItens.reduce((a,i)=>a+Number(i.qty||0),0);
  const compraTotal=newItens.reduce((a,i)=>a+(Number(i.preco_compra_unit||0)*Number(i.qty||0)),0);
  const preco_compra_unit=qtdTotal>0?compraTotal/qtdTotal:0;
  const cliente=(document.getElementById('edit-venda-cliente')?.value||'').trim()||venda.cliente||'';
  const pagamento=document.getElementById('edit-venda-pagamento')?.value||venda.pagamento||'cash';
  const payload={produto_id:newItens[0]?.id||null,produto_nome:getVendaTitulo({itens_json:newItens}),qty:qtdTotal,total,pagamento,preco_compra_unit,cliente,itens_json:JSON.stringify(newItens)};
  const {error}=await db.from('vendas').update(payload).eq('id',id);
  if(error){showToast('Erro ao guardar edição','red');return;}
  await loadProdutos(); await loadVendas(); await loadGerenciaVendas();
  closeModal(); renderAll(); renderGerencia(); showToast('Venda actualizada!','green');
}
async function apagarVendaGerencia(id){
  if(currentUser?.role!=='gerencia'){showToast('Apenas a gerência pode apagar vendas','red');return;}
  if(!confirm('Apagar esta venda? O stock dos produtos será devolvido.'))return;
  if(!dbOk){showToast('❌ Sem ligação. Tenta novamente.','red');return;}
  const venda=getVendaById(id); if(!venda){showToast('Venda não encontrada','red');return;}
  const oldItens=getVendaItensParaEdicao(venda);
  const ok=await ajustarStockPorVenda(oldItens,[]); if(!ok)return;
  const {error}=await db.from('vendas').delete().eq('id',id);
  if(error){showToast('Erro ao apagar venda','red');return;}
  await loadProdutos(); await loadVendas(); await loadGerenciaVendas();
  renderAll(); renderGerencia(); showToast('Venda apagada e stock devolvido','green');
}


function getInicioSemana(base=new Date()){
  const d=new Date(base);
  const day=(d.getDay()+6)%7;
  d.setHours(0,0,0,0);
  d.setDate(d.getDate()-day);
  return d;
}
function getInicioMes(base=new Date()){
  return new Date(base.getFullYear(),base.getMonth(),1);
}
function getInicioTrimestre(base=new Date()){
  const q=Math.floor(base.getMonth()/3)*3;
  return new Date(base.getFullYear(),q,1);
}
function getInicioSemestre(base=new Date()){
  const s=base.getMonth()<6?0:6;
  return new Date(base.getFullYear(),s,1);
}
function getInicioAno(base=new Date()){
  return new Date(base.getFullYear(),0,1);
}
function filtrarVendasPorPeriodo(lista,periodo){
  const agora=new Date();
  const iniHoje=new Date(); iniHoje.setHours(0,0,0,0);
  let inicio=iniHoje;
  if(periodo==='semana')inicio=getInicioSemana(agora);
  else if(periodo==='mes')inicio=getInicioMes(agora);
  else if(periodo==='trimestre')inicio=getInicioTrimestre(agora);
  else if(periodo==='semestre')inicio=getInicioSemestre(agora);
  else if(periodo==='ano')inicio=getInicioAno(agora);
  return (lista||[]).filter(v=>{
    const dt=v.criado_em?new Date(v.criado_em):null;
    return dt && dt>=inicio && dt<=agora;
  }).sort((a,b)=>new Date(b.criado_em)-new Date(a.criado_em));
}
function labelPeriodoGer(periodo){
  return ({hoje:'Resumo de hoje',semana:'Resumo da semana',mes:'Resumo do mês',trimestre:'Resumo do trimestre',semestre:'Resumo do semestre',ano:'Resumo do ano'})[periodo]||'Resumo';
}
function nomeDiaSemana(i){
  return ['Domingo','Segunda','Terça','Quarta','Quinta','Sexta','Sábado'][i]||'';
}
function nomeMes(i){
  return ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'][i]||'';
}
function resumoGrupoVendas(lista){
  return {
    vendas: lista.length,
    qtd: lista.reduce((a,v)=>a+Number(v.qty||0),0),
    total: lista.reduce((a,v)=>a+Number(v.total||0),0)

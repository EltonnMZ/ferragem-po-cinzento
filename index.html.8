async function regAluguel(){
  const id=parseInt(document.getElementById('al-material')?.value);
  const cliente=document.getElementById('al-cliente')?.value.trim();
  const contacto=document.getElementById('al-contacto')?.value.trim();
  const dias=parseInt(document.getElementById('al-dias')?.value)||1;

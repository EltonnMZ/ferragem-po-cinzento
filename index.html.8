  renderMateriaisSelect();
  const activos=alugueis.filter(a=>a.estado==='activo');
  const historico=alugueis.filter(a=>a.estado==='devolvido');
  const container=document.getElementById('al-activos');
  if(!container)return;
  if(!activos.length){
    container.innerHTML='<div class="card"><div class="empty">Nenhum aluguel activo</div></div>';
  } else {
    container.innerHTML=activos.map(a=>{
      const devol=new Date(a.data_devolucao);
      const hoje=new Date();hoje.setHours(0,0,0,0);
      const diff=Math.ceil((devol-hoje)/(1000*60*60*24));
      let ac='var(--green)',am=diff+' dia'+(diff!==1?'s':'')+' para devolver';
      if(diff<=0){ac='var(--red)';am='ATRASADO — '+Math.abs(diff)+' dia'+(Math.abs(diff)!==1?'s':'')+'!';}
      else if(diff<=2){ac='var(--yellow)';am='Devolve em '+diff+' dia'+(diff!==1?'s':'')+'!';}
      const pb=a.pagamento==='mpesa'?'<span class="badge-mpesa">M-Pesa</span>':a.pagamento==='emola'?'<span class="badge-emola">E-Mola</span>':'<span class="badge-cash">Numerário</span>';
      return`<div class="card" style="border-left:3px solid ${ac};border-radius:0 16px 16px 0;margin-bottom:10px">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px">
          <div style="flex:1;min-width:0">
             <div style="font-size:15px;font-weight:600;font-family:var(--font-head)">${escapeHTML(a.material_icone)} ${escapeHTML(a.material_nome)}</div>
             <div style="font-size:12px;color:var(--muted);margin-top:2px">👤 ${escapeHTML(a.cliente)} · 📞 ${escapeHTML(a.contacto||'—')}</div>
             <div style="font-size:11px;color:var(--muted);margin-top:2px">Por: ${escapeHTML(a.funcionario)} ${pb}</div>
          </div>
          <div style="text-align:right;flex-shrink:0">
            <div style="font-size:16px;font-weight:700;font-family:var(--font-head);color:var(--green)">${a.total.toLocaleString()} MZN</div>
            <div style="font-size:10px;color:var(--muted)">${a.dias}d · ${a.preco_dia.toLocaleString()}/dia</div>
          </div>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center">
          <div style="font-size:11px;font-weight:600;color:${ac}">${am}</div>
          <button class="btn btn-outline btn-sm" onclick="devolverAluguel(${a.id})">✓ Devolvido</button>
        </div>
      </div>`;
    }).join('');
  }
  const hist=document.getElementById('al-historico');
  if(!hist)return;
  hist.innerHTML=historico.length?historico.slice(0,20).map(a=>{
    const pb=a.pagamento==='mpesa'?'<span class="badge-mpesa">M-Pesa</span>':a.pagamento==='emola'?'<span class="badge-emola">E-Mola</span>':'<span class="badge-cash">Numerário</span>';
    return`<div class="venda-row">
      <div class="venda-time" style="min-width:48px;font-size:10px">${a.data_inicio||''}</div>
      <div class="venda-info"><div class="venda-name">${escapeHTML(a.material_icone)} ${escapeHTML(a.material_nome)}</div><div class="venda-func">${escapeHTML(a.cliente)} · ${a.dias}d ${pb}</div></div>
      <div class="venda-total">${a.total.toLocaleString()} MZN</div>
    </div>`;
  }).join(''):'<div class="empty">Sem histórico ainda</div>';
}

function checkAlugueisAtraso(){
  const hoje=new Date();hoje.setHours(0,0,0,0);
  const atrasados=alugueis.filter(a=>a.estado==='activo'&&new Date(a.data_devolucao)<hoje).length;
  if(atrasados>0)showToast('⚠️ '+atrasados+' aluguel(is) em atraso!','red');
}

// ── RELATÓRIOS ──
let relPeriodo='dia';
let relVendasCache=[];

function abrirRelatorios(){
  document.getElementById('rel-overlay').style.display='block';
  // definir datas padrão = hoje
  const hoje=new Date().toISOString().slice(0,10);
  document.getElementById('rel-de').value=hoje;
  document.getElementById('rel-ate').value=hoje;
  carregarRelatorio();
}
function fecharRelatorios(){
  document.getElementById('rel-overlay').style.display='none';
}
function selectRelTab(periodo,btn){
  relPeriodo=periodo;
  document.querySelectorAll('.rel-tab').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  const hoje=new Date();
  const fmt=d=>d.toISOString().slice(0,10);
  if(periodo==='dia'){
    document.getElementById('rel-de').value=fmt(hoje);
    document.getElementById('rel-ate').value=fmt(hoje);
  } else if(periodo==='semana'){
    const seg=new Date(hoje);seg.setDate(hoje.getDate()-hoje.getDay()+1);
    const dom=new Date(seg);dom.setDate(seg.getDate()+6);
    document.getElementById('rel-de').value=fmt(seg);
    document.getElementById('rel-ate').value=fmt(dom);
  } else if(periodo==='mes'){
    const ini=new Date(hoje.getFullYear(),hoje.getMonth(),1);
    const fim=new Date(hoje.getFullYear(),hoje.getMonth()+1,0);
    document.getElementById('rel-de').value=fmt(ini);
    document.getElementById('rel-ate').value=fmt(fim);
  }
  carregarRelatorio();
}

async function carregarRelatorio(){
  const de=document.getElementById('rel-de').value;
  const ate=document.getElementById('rel-ate').value;
  if(!de||!ate){return;}
  const content=document.getElementById('rel-content');
  content.innerHTML='<div style="text-align:center;padding:30px;color:var(--muted)">⏳ A carregar...</div>';
  document.getElementById('rel-print-bar').style.display='none';

  const dados=await loadTodasVendas(de,ate);
  relVendasCache=dados;

  if(!dados.length){
    content.innerHTML='<div style="text-align:center;padding:40px;color:var(--muted)">Sem vendas neste período</div>';
    return;
  }

  const tot=dados.reduce((a,v)=>a+v.total,0);
  const custo=dados.reduce((a,v)=>a+(v.preco_compra_unit||0)*v.qty,0);
  const lucro=tot-custo;
  const margem=tot>0?Math.round((lucro/tot)*100):0;
  const cash=dados.filter(v=>!v.pagamento||v.pagamento==='cash').reduce((a,v)=>a+v.total,0);
  const mpesa=dados.filter(v=>v.pagamento==='mpesa').reduce((a,v)=>a+v.total,0);
  const emola=dados.filter(v=>v.pagamento==='emola').reduce((a,v)=>a+v.total,0);

  // Agrupamento por produto
  const porProd={};
  dados.forEach(v=>{
    if(!porProd[v.produto_nome])porProd[v.produto_nome]={qty:0,total:0};
    porProd[v.produto_nome].qty+=v.qty;
    porProd[v.produto_nome].total+=v.total;
  });
  const topProd=Object.entries(porProd).sort((a,b)=>b[1].total-a[1].total);

  // Agrupamento por funcionário
  const porFunc={};
  dados.forEach(v=>{
    if(!porFunc[v.funcionario])porFunc[v.funcionario]={qtd:0,total:0};
    porFunc[v.funcionario].qtd++;
    porFunc[v.funcionario].total+=v.total;
  });

  const labelPeriodo=de===ate?`📅 ${new Date(de+'T12:00:00').toLocaleDateString('pt-MZ',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}`:`📆 ${new Date(de+'T12:00:00').toLocaleDateString('pt-MZ',{day:'numeric',month:'short'})} → ${new Date(ate+'T12:00:00').toLocaleDateString('pt-MZ',{day:'numeric',month:'short',year:'numeric'})}`;

  content.innerHTML=`
    <div style="background:var(--surface);border-radius:14px;padding:14px 16px;margin-bottom:16px;border:1px solid var(--border)">
      <div style="font-size:11px;color:var(--muted);margin-bottom:4px">${labelPeriodo}</div>
      <div style="font-family:var(--font-head);font-size:22px;font-weight:800;color:var(--accent)">${tot.toLocaleString()} MZN</div>
      <div style="font-size:11px;color:var(--green);margin-top:2px">Lucro: ${lucro.toLocaleString()} MZN (${margem}%)</div>
    </div>

    <div class="rel-stat-grid">
      <div class="rel-stat"><div class="rel-stat-label">Nº Vendas</div><div class="rel-stat-val">${dados.length}</div></div>
      <div class="rel-stat"><div class="rel-stat-label">Qtd. vendida</div><div class="rel-stat-val">${formatQty(dados.reduce((a,v)=>a+Number(v.qty||0),0))}</div></div>
      <div class="rel-stat"><div class="rel-stat-label">Receita</div><div class="rel-stat-val green" style="color:var(--green);font-size:18px">${tot.toLocaleString()}</div></div>
      <div class="rel-stat"><div class="rel-stat-label">Custo</div><div class="rel-stat-val" style="color:var(--red);font-size:18px">${custo.toLocaleString()}</div></div>
      <div class="rel-stat"><div class="rel-stat-label">Lucro líquido</div><div class="rel-stat-val" style="color:var(--green);font-size:18px">${lucro.toLocaleString()}</div></div>
    </div>

    <div class="rel-section">💳 Métodos de pagamento</div>
    <div class="rel-stat-grid" style="grid-template-columns:1fr 1fr 1fr">
      <div class="rel-stat"><div class="rel-stat-label">Numerário</div><div class="rel-stat-val" style="font-size:15px;color:#afa9ec">${cash.toLocaleString()}</div></div>
      <div class="rel-stat"><div class="rel-stat-label">M-Pesa</div><div class="rel-stat-val" style="font-size:15px;color:var(--green)">${mpesa.toLocaleString()}</div></div>
      <div class="rel-stat"><div class="rel-stat-label">E-Mola</div><div class="rel-stat-val" style="font-size:15px;color:var(--yellow)">${emola.toLocaleString()}</div></div>
    </div>

    <div class="rel-section">🏆 Produtos mais vendidos</div>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:4px 14px">
      ${topProd.map(([nome,v])=>`<div class="rel-row">
        <div class="rel-info"><div class="rel-name">${nome}</div><div class="rel-sub">${formatQty(v.qty)} unidades vendidas</div></div>
        <div class="rel-total">${v.total.toLocaleString()} MZN</div>
      </div>`).join('')}
    </div>

    <div class="rel-section">👤 Por funcionário</div>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:4px 14px">
      ${Object.entries(porFunc).map(([nome,v])=>`<div class="rel-row">
        <div class="rel-info"><div class="rel-name">${nome}</div><div class="rel-sub">${v.qtd} vendas</div></div>
        <div class="rel-total">${v.total.toLocaleString()} MZN</div>
      </div>`).join('')}
    </div>

    <div class="rel-section">📋 Detalhe de todas as vendas</div>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:4px 14px">
      ${dados.map(v=>{
        const pb=v.pagamento==='mpesa'?'M-Pesa':v.pagamento==='emola'?'E-Mola':'Num.';
        const dt=v.criado_em?new Date(v.criado_em):null;
        const hora=dt?dt.toTimeString().slice(0,5):'';
        const data=dt?dt.toLocaleDateString('pt-MZ',{day:'2-digit',month:'2-digit'}):'';
        return`<div class="rel-row">
          <div class="rel-time">${data}<br>${hora}</div>
          <div class="rel-info"><div class="rel-name">${v.produto_nome}</div><div class="rel-sub">Qtd: ${formatQty(v.qty)} · ${v.funcionario} · ${pb}</div></div>
          <div class="rel-total">${v.total.toLocaleString()} MZN</div>
        </div>`;
      }).join('')}
    </div>
  `;
  document.getElementById('rel-print-bar').style.display='flex';
}

function imprimirRelatorio(){
  window.print();
}

function exportarRelatorioTxt(){
  const de=document.getElementById('rel-de').value;
  const ate=document.getElementById('rel-ate').value;
  const dados=relVendasCache;
  if(!dados.length){showToast('Sem dados para exportar','red');return;}
  const tot=dados.reduce((a,v)=>a+v.total,0);
  const custo=dados.reduce((a,v)=>a+(v.preco_compra_unit||0)*v.qty,0);
  const lucro=tot-custo;
  const cash=dados.filter(v=>!v.pagamento||v.pagamento==='cash').reduce((a,v)=>a+v.total,0);
  const mpesa=dados.filter(v=>v.pagamento==='mpesa').reduce((a,v)=>a+v.total,0);
  const emola=dados.filter(v=>v.pagamento==='emola').reduce((a,v)=>a+v.total,0);
  const lines=[
    '============================================',
    '   RELATÓRIO — FERRAGEM PÓ CINZENTO',
    '============================================',
    `Período: ${de} a ${ate}`,
    `Gerado em: ${new Date().toLocaleString('pt-MZ')}`,
    '',
    '--- RESUMO ---',
    `Total de vendas: ${dados.length}`,
    `Quantidade total vendida: ${formatQty(dados.reduce((a,v)=>a+Number(v.qty||0),0))}`,
    `Receita total:   ${tot.toLocaleString()} MZN`,
    `  Numerário:     ${cash.toLocaleString()} MZN`,
    `  M-Pesa:        ${mpesa.toLocaleString()} MZN`,
    `  E-Mola:        ${emola.toLocaleString()} MZN`,
    `Custo merc.:     ${custo.toLocaleString()} MZN`,
    `LUCRO LÍQUIDO:   ${lucro.toLocaleString()} MZN`,
    '',
    '--- VENDAS DETALHADAS ---',
    ...dados.map(v=>{
      const dt=v.criado_em?new Date(v.criado_em).toLocaleString('pt-MZ'):'';
      return`${dt} | ${v.produto_nome} | ${v.qty}un | ${v.total.toLocaleString()}MZN | ${v.funcionario} | ${v.pagamento||'cash'}`;
    }),
    '',
    '============================================',
  ];
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([lines.join('\n')],{type:'text/plain;charset=utf-8'}));
  a.download=`relatorio_${de}_${ate}.txt`;
  a.click();
}


// PAGAMENTO
function selectPag(tipo){
  pagamento=tipo;
  ['cash','mpesa','emola'].forEach(t=>{
    const b=document.getElementById('pag-'+t);
    b.className='pag-btn';
    if(t===tipo)b.classList.add('selected-'+t);
  });
  // mostrar/esconder troco (só numerário)
  const ts=document.getElementById('troco-section');
  if(ts)ts.style.display=tipo==='cash'?'block':'none';
  calcTroco();
}

function calcTroco(){
  const total=getTotal();
  const entregue=parseFloat(document.getElementById('v-entregue')?.value)||0;
  const tv=document.getElementById('troco-val');
  if(!tv)return;
  if(pagamento!=='cash'){tv.textContent='—';return;}
  if(!entregue){tv.textContent='—';return;}
  const troco=entregue-total;
  tv.textContent=troco>=0?troco.toLocaleString()+' MZN':'Valor insuficiente';
  tv.className='troco-val big'+(troco<0?' neg':'');
}
function preencherValorEntregue(valor){
  const input=document.getElementById('v-entregue');
  if(!input)return;
  const total=getTotal();
  input.value=valor==='exact'?Math.ceil(total):valor;
  calcTroco();
}

function getStatus(p){
  if(p.qty===0)return{label:'Esgotado',cls:'badge-out'};
  if(p.qty<p.minimo)return{label:'Baixo',cls:'badge-low'};
  return{label:'OK',cls:'badge-ok'};
}

// DASHBOARD
function renderDashboard(){
  const tot=vendas.reduce((a,v)=>a+v.total,0);
  const esg=produtos.filter(p=>p.qty===0).length;
  const bx=produtos.filter(p=>p.qty>0&&p.qty<p.minimo).length;
  document.getElementById('dash-stats').innerHTML=`
    <div class="stat-card"><div class="stat-label">Vendas hoje</div><div class="stat-val green">${vendas.length}</div></div>
    <div class="stat-card"><div class="stat-label">Total (MZN)</div><div class="stat-val green">${tot.toLocaleString()}</div></div>
    <div class="stat-card"><div class="stat-label">Esgotados</div><div class="stat-val ${esg>0?'red':'green'}">${esg}</div></div>
    <div class="stat-card"><div class="stat-label">Stock baixo</div><div class="stat-val ${bx>0?'yellow':'green'}">${bx}</div></div>`;
  let al='';
  produtos.filter(p=>p.qty===0).forEach(p=>{al+=`<div class="alert alert-red"><div class="alert-dot alert-dot-red"></div><div><div class="alert-title">Esgotado: ${escapeHTML(p.nome)}</div><div class="alert-body">Repor imediatamente</div></div></div>`;});
  produtos.filter(p=>p.qty>0&&p.qty<p.minimo).forEach(p=>{al+=`<div class="alert alert-yellow"><div class="alert-dot alert-dot-yellow"></div><div><div class="alert-title">Stock baixo: ${escapeHTML(p.nome)}</div><div class="alert-body">${formatQty(p.qty)} un. restantes (mín: ${formatQty(p.minimo)})</div></div></div>`;});
  if(!al)al='<div class="alert alert-green"><div class="alert-dot alert-dot-green"></div><div><div class="alert-title">Tudo em ordem</div><div class="alert-body">Nenhum alerta activo</div></div></div>';
  document.getElementById('dash-alertas').innerHTML=al;
  const dv=document.getElementById('dash-vendas');
  dv.innerHTML=vendas.length?vendas.slice().reverse().map(v=>{
    const pb=v.pagamento==='mpesa'?'<span class="badge-mpesa">M-Pesa</span>':v.pagamento==='emola'?'<span class="badge-emola">E-Mola</span>':'<span class="badge-cash">Numerário</span>';
    return`<div class="venda-row"><div class="venda-time">${v.criado_em?new Date(v.criado_em).toTimeString().slice(0,5):''}</div><div class="venda-info">${v.cliente?`<div class="cliente-badge">${escapeHTML(v.cliente)}</div>`:''}<div class="venda-name">${escapeHTML(getVendaTitulo(v))}</div><div class="venda-func">${escapeHTML(v.funcionario)} · ${formatQty(v.qty)} item(ns) ${pb}</div></div><div class="venda-total">${Number(v.total||0).toLocaleString()} MZN</div></div>`;
  }).join(''):'<div class="empty">Sem vendas hoje</div>';
}

// STOCK
function renderStock(){
  const q=(document.getElementById('search-prod').value||'').toLowerCase();
  const list=produtos.filter(p=>p.nome.toLowerCase().includes(q));
  const isGer=currentUser&&currentUser.role==='gerencia';
  const el=document.getElementById('stock-list');
  if(!list.length){el.innerHTML='<div class="empty">Nenhum produto encontrado</div>';return;}
  el.innerHTML=list.map(p=>{
    const st=getStatus(p);
    const pv=Number(p.preco_venda||p.preco||0);
    const pc=Number(p.preco_compra||0);
    const meta=isGer
      ?`Venda: ${pv.toLocaleString()} MZN · Compra: ${pc.toLocaleString()} MZN · Mín: ${p.minimo}`
      :`${pv.toLocaleString()} MZN · Mín: ${p.minimo}`;
    const editBtn=isGer?`<button class="btn btn-outline btn-sm" style="margin-top:8px" onclick="openModal('edit-prod',${p.id})">Editar</button>`:'';
    return`<div class="prod-row">
      <div class="prod-icon">${escapeHTML(p.icone||'📦')}</div>
      <div class="prod-info"><div class="prod-name">${escapeHTML(p.nome)}</div><div class="prod-meta">${meta}</div>${editBtn}</div>
      <div class="prod-stock">
        <div class="prod-qty" style="color:${p.qty===0?'var(--red)':p.qty<p.minimo?'var(--yellow)':'var(--green)'}">${formatQty(p.qty)}</div>
        <div class="prod-unit">un.</div>
        <div style="margin-top:4px"><span class="badge ${st.cls}">${st.label}</span></div>
      </div></div>`;
  }).join('');
}

// VENDER
function getVendaItens(v){
  if(v.itens_json){
    try{return typeof v.itens_json==='string'?JSON.parse(v.itens_json):(Array.isArray(v.itens_json)?v.itens_json:[]);}catch(e){return [];}
  }
  return [];
}
function getVendaTitulo(v){
  const itens=getVendaItens(v);
  if(itens.length)return `Venda múltipla (${itens.length} produto${itens.length>1?'s':''})`;
  return v.produto_nome||'Venda';
}
function getVendaDetalhes(v){
  const itens=getVendaItens(v);
  if(!itens.length)return v.qty?`Qtd: ${formatQty(v.qty)}`:'';
  return itens.map(i=>`${i.nome} — ${formatQty(i.qty)} un. x ${Number(i.preco_unit||0).toLocaleString()} = ${Number(i.subtotal||0).toLocaleString()} MZN`).join('<br>');
}
async function gerarClienteAutomatico(){
  const hoje=new Date();
  const inicio=new Date(hoje.getFullYear(),hoje.getMonth(),hoje.getDate()).toISOString();
  const {data,error}=await db.from('vendas').select('id').gte('criado_em',inicio);
  const n=error?1:(data||[]).length+1;
  return 'Cliente '+String(n).padStart(3,'0');
}


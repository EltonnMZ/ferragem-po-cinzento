}function resumoGrupoVendasDetalhado(lista){
  const vendasNum=lista.length;
  const qtd=lista.reduce((a,v)=>a+Number(v.qty||0),0);
  const total=lista.reduce((a,v)=>a+Number(v.total||0),0);

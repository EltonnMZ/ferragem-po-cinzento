function getSaudacao(){
  const h=new Date().getHours();
  if(h>=5&&h<12)return'Bom dia';
  if(h>=12&&h<19)return'Boa tarde';
  return'Boa noite';
}

function getMensagemUser(name){
  const msgs=mensagensFunc[name]||mensagensFunc['Gerência'];
  return msgs[Math.floor(Math.random()*msgs.length)];
}

function getFraseDashboard(){
  return frasesDashboard[Math.floor(Math.random()*frasesDashboard.length)];
}

function updateLoginClock(){
  const now=new Date();
  const h=now.getHours().toString().padStart(2,'0');
  const m=now.getMinutes().toString().padStart(2,'0');
  const dias=['Domingo','Segunda','Terça','Quarta','Quinta','Sexta','Sábado'];
  const meses=['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
  const el=document.getElementById('login-hora');
  if(el)el.textContent='🕐 '+h+':'+m+' · '+dias[now.getDay()]+', '+now.getDate()+' '+meses[now.getMonth()]+' '+now.getFullYear();
}

function updateDashClock(){
  const now=new Date();
  const h=now.getHours().toString().padStart(2,'0');
  const m=now.getMinutes().toString().padStart(2,'0');
  const dias=['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
  const meses=['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
  const horaEl=document.getElementById('dash-hora-live');
  const dataEl=document.getElementById('dash-data-live');
  if(horaEl)horaEl.textContent=h+':'+m;
  if(dataEl)dataEl.textContent=dias[now.getDay()]+', '+now.getDate()+' '+meses[now.getMonth()];
}

function updateWelcomeBanner(){
  if(!currentUser)return;
  const saud=document.getElementById('dash-saudacao');
  const nome=document.getElementById('dash-nome-user');
  const msg=document.getElementById('dash-mensagem-user');
  if(saud)saud.textContent=getSaudacao()+', bem-vindo!';
  if(nome)nome.textContent=currentUser.name;
  if(msg){
    msg.innerHTML=`${getFraseDashboard()}<br><span style="color:var(--muted);font-style:italic">— ${AUTOR_MOTIVACAO}</span><br><span style="color:var(--text)">${getMensagemUser(currentUser.name)}</span>`;
  }
  updateDashClock();
  setInterval(updateDashClock,60000);
}

function initLoginAnimations(){
  const f=frasesLogin[Math.floor(Math.random()*frasesLogin.length)];
  const el=document.getElementById('login-frase');
  const em=document.getElementById('login-emoji');
  const autor=document.getElementById('login-frase-autor');
  if(el)el.textContent=f.frase;
  if(em)em.textContent=f.emoji;
  if(autor)autor.textContent='— '+AUTOR_MOTIVACAO;
  updateLoginClock();
  setInterval(updateLoginClock,30000);
}




function getSemanaDoMes(dt){
  const primeiro=new Date(dt.getFullYear(),dt.getMonth(),1);
  const offset=(primeiro.getDay()+6)%7;
  return Math.floor((dt.getDate()+offset-1)/7)+1;
}
function agruparGerVendas(lista,periodo){
  const agora=new Date();
  const grupos=[];
  if(periodo==='hoje'){
    grupos.push({titulo:'Hoje', subtitulo:agora.toLocaleDateString('pt-MZ',{weekday:'long',day:'2-digit',month:'long'}), lista});
    return grupos;
  }
  if(periodo==='semana'){
    const ini=getInicioSemana(agora);
    for(let i=0;i<7;i++){
      const d=new Date(ini); d.setDate(ini.getDate()+i);
      const vendasDia=lista.filter(v=>{const dt=new Date(v.criado_em); return dt.getFullYear()===d.getFullYear()&&dt.getMonth()===d.getMonth()&&dt.getDate()===d.getDate();});
      grupos.push({titulo:nomeDiaSemana(d.getDay()), subtitulo:d.toLocaleDateString('pt-MZ',{day:'2-digit',month:'2-digit'}), lista:vendasDia});
    }
    return grupos;
  }
  if(periodo==='mes'){
    const ano=agora.getFullYear(), mes=agora.getMonth();
    for(let s=1;s<=5;s++){
      const vendasSemana=lista.filter(v=>{const dt=new Date(v.criado_em); return dt.getFullYear()===ano&&dt.getMonth()===mes&&getSemanaDoMes(dt)===s;});
      grupos.push({titulo:`Semana ${s}`, subtitulo:nomeMes(mes), lista:vendasSemana});
    }
    return grupos;
  }
  const mesesBack = periodo==='trimestre'?3:periodo==='semestre'?6:12;
  const seq=[];
  for(let i=mesesBack-1;i>=0;i--){
    const d=new Date(agora.getFullYear(),agora.getMonth()-i,1);
    seq.push(d);
  }
  seq.forEach(d=>{
    const vendasMes=lista.filter(v=>{const dt=new Date(v.criado_em); return dt.getFullYear()===d.getFullYear()&&dt.getMonth()===d.getMonth();});
    grupos.push({titulo:nomeMes(d.getMonth()), subtitulo:String(d.getFullYear()), lista:vendasMes});
  });
  return grupos;
}

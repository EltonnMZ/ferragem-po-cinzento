  document.body.classList.add('printing-recibo');
  window.print();
}
window.addEventListener('afterprint',()=>document.body.classList.remove('printing-recibo'));
function exportarReciboTxt(){
  if(!ultimoRecibo){showToast('Sem recibo para exportar','red');return;}
  const v=ultimoRecibo;
  const linhas=[
    FERRAGEM_INFO.nome,
    `Localização: ${FERRAGEM_INFO.localizacao}`,
    `NUIT: ${FERRAGEM_INFO.nuit}`,
    `Contacto: ${FERRAGEM_INFO.contacto}`,
    '',
    `RECIBO Nº: ${v.id||'—'}`,
    `Data: ${formatDateTimeRecibo(v.data)}`,
    `Cliente: ${v.cliente||'Cliente balcão'}`,
    `Funcionário: ${v.funcionario||'—'}`,
    `Pagamento: ${getPagamentoLabel(v.pagamento)}`,
    '',
    'ITENS:'
  ];
  (v.itens||[]).forEach(i=>{
    linhas.push(`${i.nome} | Qtd: ${formatQty(i.qty)} | Unit: ${Number(i.preco_unit||0).toLocaleString()} MZN | Total: ${Number(i.subtotal||0).toLocaleString()} MZN`);
  });
  linhas.push('',`TOTAL: ${Number(v.total||0).toLocaleString()} MZN`);
  if(v.pagamento==='cash'){
    linhas.push(`Recebido: ${Number(v.entregue||0).toLocaleString()} MZN`);
    linhas.push(`Troco: ${Math.max(0,Number(v.entregue||0)-Number(v.total||0)).toLocaleString()} MZN`);
  }
  linhas.push('',FERRAGEM_INFO.rodape);
  const blob=new Blob([linhas.join('\n')],{type:'text/plain;charset=utf-8'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download=`recibo-${v.id||Date.now()}.txt`;
  a.click();
  URL.revokeObjectURL(a.href);
}
function finalizarCarrinhoAtivoAposVenda(){
  const idx=carrinhosVenda.findIndex(c=>c.id===carrinhoAtivoId);
  if(carrinhosVenda.length>1 && idx>=0){
    carrinhosVenda.splice(idx,1);
    carrinhosVenda.forEach((c,i)=>c.nome='Carrinho '+(i+1));
    carrinhoAtivoId=(carrinhosVenda[idx]||carrinhosVenda[idx-1]||carrinhosVenda[0]).id;
  }else{
    carrinhosVenda=[{id:1,nome:'Carrinho 1',itens:[],cliente:'',pagamento:'cash',entregue:''}];
    carrinhoAtivoId=1;
    proximoCarrinhoId=2;
  }
  carrinhoVenda=(getCarrinhoAtivo().itens||[]).map(i=>({...i}));
  const cliente=document.getElementById('v-cliente');
  const search=document.getElementById('search-venda-prod');
  const entregue=document.getElementById('v-entregue');
  const qty=document.getElementById('v-qty');
  const prod=document.getElementById('v-prod');
  if(cliente)cliente.value=getCarrinhoAtivo().cliente||'';
  if(search)search.value='';
  if(entregue)entregue.value=getCarrinhoAtivo().entregue||'';
  if(qty)qty.value='1';
  if(prod)prod.value='';
  pagamento=getCarrinhoAtivo().pagamento||'cash';
  selectPag(pagamento);
